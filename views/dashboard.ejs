<div class="container-fluid py-4">
    <!-- Welcome Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="welcome-card">
                <div class="welcome-content">
                    <h2>Welcome back, <strong><%= currentUser.full_name %></strong>! 👋</h2>
                    <p>Here's what's happening in your hospital today.</p>
                </div>
                <div class="welcome-date">
                    <i class="bi bi-calendar3 me-2"></i>
                    <span id="currentDate"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-patients">
                <div class="stat-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-details">
                    <h3 class="stat-number"><%= typeof stats !== 'undefined' ? stats.totalPatients : 0 %></h3>
                    <p class="stat-label">Total Patients</p>
                </div>
                <div class="stat-trend up">
                    <i class="bi bi-arrow-up-short"></i> Active
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-appointments">
                <div class="stat-icon">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>
                <div class="stat-details">
                    <h3 class="stat-number"><%= typeof stats !== 'undefined' ? stats.todayAppointments : 0 %></h3>
                    <p class="stat-label">Today's Appointments</p>
                </div>
                <div class="stat-trend">
                    <i class="bi bi-clock"></i> Today
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-revenue">
                <div class="stat-icon">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div class="stat-details">
                    <h3 class="stat-number">Rs. <%= typeof stats !== 'undefined' ? stats.revenue : '0.00' %></h3>
                    <p class="stat-label">Revenue Summary</p>
                </div>
                <div class="stat-trend up">
                    <i class="bi bi-graph-up-arrow"></i> This Month
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-lab">
                <div class="stat-icon">
                    <i class="bi bi-droplet-fill"></i>
                </div>
                <div class="stat-details">
                    <h3 class="stat-number"><%= typeof stats !== 'undefined' ? stats.labRequests : 0 %></h3>
                    <p class="stat-label">Lab Requests</p>
                </div>
                <div class="stat-trend">
                    <i class="bi bi-hourglass-split"></i> Pending
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <h5 class="section-title"><i class="bi bi-lightning-fill me-2"></i>Quick Actions</h5>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="/patients/add" class="quick-action-card">
                <i class="bi bi-person-plus-fill"></i>
                <span>Register Patient</span>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="/appointments/new" class="quick-action-card">
                <i class="bi bi-calendar-plus-fill"></i>
                <span>Book Appointment</span>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="/billing/new" class="quick-action-card">
                <i class="bi bi-receipt"></i>
                <span>Generate Bill</span>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="/laboratory/new" class="quick-action-card">
                <i class="bi bi-clipboard2-pulse"></i>
                <span>Lab Request</span>
            </a>
        </div>
    </div>

    <!-- Recent Activity Table -->
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recent Activity</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>User</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof recentLogs !== 'undefined' && recentLogs.length > 0) { %>
                                    <% recentLogs.forEach(log => { %>
                                        <tr>
                                            <td>
                                                <span class="badge bg-primary-subtle text-primary"><%= log.action %></span>
                                            </td>
                                            <td><%= log.full_name || 'System' %></td>
                                            <td><%= log.created_at %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">
                                            <i class="bi bi-inbox me-2"></i>No recent activity
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>System Info</h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled system-info-list">
                        <li>
                            <span class="info-label">Your Role</span>
                            <span class="badge bg-success"><%= currentUser.role_name %></span>
                        </li>
                        <li>
                            <span class="info-label">Status</span>
                            <span class="badge bg-success"><i class="bi bi-circle-fill me-1" style="font-size:6px"></i> Online</span>
                        </li>
                        <li>
                            <span class="info-label">Version</span>
                            <span class="text-muted">v1.0.0</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Display current date
    const dateEl = document.getElementById('currentDate');
    if (dateEl) {
        dateEl.textContent = new Date().toLocaleDateString('en-US', {
            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
        });
    }
</script>
