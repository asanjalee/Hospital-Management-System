<!-- Electronic Medical Records (EMR) Directory View -->
<div class="container-fluid px-0">

    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Header Banner & Action -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-file-earmark-medical-fill text-primary me-2"></i>Electronic Medical Records (EMR)
            </h3>
            <p class="text-muted mb-0">Patient clinical diagnoses, prescriptions, treatment history, and vital signs monitoring</p>
        </div>
        <div>
            <a href="/emr/add" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium">
                <i class="bi bi-journal-plus fs-5"></i>
                <span>Log New Diagnosis</span>
            </a>
        </div>
    </div>

    <!-- Metric KPI Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; align-items: stretch; margin-bottom: 1.5rem;">
        <div>
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; flex-shrink: 0;">
                        <i class="bi bi-journal-medical fs-3"></i>
                    </div>
                    <div style="min-width: 0;">
                        <div class="text-muted small fw-medium text-truncate">Total EMR Entries</div>
                        <h4 class="fw-bold mb-0 text-dark"><%= stats.total %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; flex-shrink: 0;">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div style="min-width: 0;">
                        <div class="text-muted small fw-medium text-truncate">Patients Diagnosed</div>
                        <h4 class="fw-bold mb-0 text-success"><%= stats.uniquePatients %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; flex-shrink: 0;">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div style="min-width: 0;">
                        <div class="text-muted small fw-medium text-truncate">Recent 30-Day Records</div>
                        <h4 class="fw-bold mb-0 text-dark"><%= stats.recentVisits %></h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <form action="/emr" method="GET" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-start-0 ps-0" placeholder="Search patient, diagnosis, doctor..." value="<%= search %>">
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <select name="patient_id" class="form-select bg-light">
                        <option value="">All Patients</option>
                        <% patients.forEach(p => { %>
                            <option value="<%= p.id %>" <%= patientId == p.id ? 'selected' : '' %>>
                                <%= p.patient_uid %> — <%= p.first_name %> <%= p.last_name %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <select name="doctor_id" class="form-select bg-light">
                        <option value="">All Doctors</option>
                        <% doctors.forEach(doc => { %>
                            <option value="<%= doc.id %>" <%= doctorId == doc.id ? 'selected' : '' %>>
                                <%= doc.full_name %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-medium">Filter</button>
                    <a href="/emr" class="btn btn-outline-secondary px-3" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- EMR Table -->
    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="card-body p-0">
            <% if (records && records.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Record ID</th>
                                <th>Visit Date</th>
                                <th>Patient</th>
                                <th>Diagnosis & Symptoms</th>
                                <th>Attending Specialist</th>
                                <th>Vitals</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% records.forEach(rec => { %>
                                <tr>
                                    <td class="ps-3">
                                        <a href="/emr/view/<%= rec.id %>" class="fw-bold text-primary text-decoration-none">
                                            EMR-<%= rec.id.toString().padStart(4, '0') %>
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark"><i class="bi bi-calendar3 me-1 text-primary"></i><%= rec.visit_date %></div>
                                        <% if (rec.appointment_number) { %>
                                            <div class="small text-muted"><i class="bi bi-ticket-perforated me-1"></i><%= rec.appointment_number %></div>
                                        <% } %>
                                    </td>
                                    <td>
                                        <a href="/patients/view/<%= rec.patient_uid %>" class="text-dark fw-bold text-decoration-none">
                                            <%= rec.patient_first_name %> <%= rec.patient_last_name %>
                                        </a>
                                        <div class="small text-muted"><i class="bi bi-card-text me-1"></i><%= rec.patient_uid %></div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= rec.diagnosis %></div>
                                        <div class="small text-muted text-truncate" style="max-width: 250px;"><%= rec.symptoms %></div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark"><%= rec.doctor_name || 'Hospital Medical Staff' %></div>
                                        <div class="small text-muted"><%= rec.specialization || 'General Practice' %></div>
                                    </td>
                                    <td>
                                        <% if (rec.vitals_bp || rec.vitals_pulse) { %>
                                            <span class="badge bg-light text-dark border me-1">
                                                <i class="bi bi-heart-pulse-fill text-danger me-1"></i><%= rec.vitals_bp || 'N/A' %>
                                            </span>
                                            <% if (rec.vitals_pulse) { %>
                                                <span class="badge bg-light text-dark border"><%= rec.vitals_pulse %> BPM</span>
                                            <% } %>
                                        <% } else { %>
                                            <span class="text-muted small">Not recorded</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end pe-3">
                                        <a href="/emr/view/<%= rec.id %>" class="btn btn-sm btn-outline-primary fw-medium me-1">View</a>
                                        <a href="/emr/edit/<%= rec.id %>" class="btn btn-sm btn-light border text-muted" title="Edit Entry"><i class="bi bi-pencil"></i></a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-file-earmark-x display-4 mb-3 text-secondary d-block"></i>
                    <h5 class="fw-bold text-dark mb-1">No Medical Records Found</h5>
                    <p class="text-muted mb-3">No EMR diagnosis history matching the search criteria was found.</p>
                    <a href="/emr/add" class="btn btn-primary fw-medium px-4">Log New Diagnosis</a>
                </div>
            <% } %>
        </div>
    </div>

</div>
