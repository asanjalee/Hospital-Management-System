<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Hospital Management System - Efficient healthcare management solution">
    <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>HMS - Hospital Management System</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 Local -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/bootstrap-fallback.css" rel="stylesheet">

    <!-- Bootstrap Icons Local -->
    <link href="/css/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Custom HMS Master Theme -->
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <!-- ===== Sidebar Navigation ===== -->
        <div class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="bi bi-hospital"></i>
                </div>
                <span class="brand-text">HMS</span>
            </div>

            <nav class="sidebar-nav">
                <a href="/dashboard" class="nav-link-sidebar <%= typeof activeMenu !== 'undefined' && activeMenu === 'dashboard' ? 'active' : '' %>">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>

                <div class="nav-section-title">MANAGEMENT</div>

                <a href="/patients" class="nav-link-sidebar <%= typeof activeMenu !== 'undefined' && activeMenu === 'patients' ? 'active' : '' %>">
                    <i class="bi bi-people-fill"></i>
                    <span>Patients</span>
                </a>
                <a href="/doctors" class="nav-link-sidebar <%= typeof activeMenu !== 'undefined' && activeMenu === 'doctors' ? 'active' : '' %>">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>Doctors</span>
                </a>
                <a href="/appointments" class="nav-link-sidebar <%= typeof activeMenu !== 'undefined' && activeMenu === 'appointments' ? 'active' : '' %>">
                    <i class="bi bi-calendar-check-fill"></i>
                    <span>Appointments</span>
                </a>
                <a href="/emr" class="nav-link-sidebar <%= typeof activeMenu !== 'undefined' && activeMenu === 'emr' ? 'active' : '' %>">
                    <i class="bi bi-file-earmark-medical-fill"></i>
                    <span>Medical Records</span>
                </a>

                <div class="nav-section-title">SERVICES</div>

                <a href="/laboratory" class="nav-link-sidebar <%= typeof activeMenu !== 'undefined' && activeMenu === 'laboratory' ? 'active' : '' %>">
                    <i class="bi bi-droplet-fill"></i>
                    <span>Laboratory</span>
                </a>
                <a href="/pharmacy" class="nav-link-sidebar <%= typeof activeMenu !== 'undefined' && activeMenu === 'pharmacy' ? 'active' : '' %>">
                    <i class="bi bi-capsule"></i>
                    <span>Pharmacy</span>
                </a>
                <a href="/billing" class="nav-link-sidebar <%= typeof activeMenu !== 'undefined' && activeMenu === 'billing' ? 'active' : '' %>">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span>Billing</span>
                </a>

                <% if (currentUser.role_name === 'Administrator') { %>
                <div class="nav-section-title">ADMIN</div>

                <a href="/staff" class="nav-link-sidebar <%= typeof activeMenu !== 'undefined' && activeMenu === 'staff' ? 'active' : '' %>">
                    <i class="bi bi-person-gear"></i>
                    <span>Staff</span>
                </a>
                <a href="/reports" class="nav-link-sidebar <%= typeof activeMenu !== 'undefined' && activeMenu === 'reports' ? 'active' : '' %>">
                    <i class="bi bi-bar-chart-line-fill"></i>
                    <span>Reports</span>
                </a>
                <a href="/admin" class="nav-link-sidebar <%= typeof activeMenu !== 'undefined' && activeMenu === 'admin' ? 'active' : '' %>">
                    <i class="bi bi-shield-lock-fill text-danger"></i>
                    <span class="text-danger fw-semibold">IT Dashboard</span>
                </a>
                <% } %>
            </nav>
        </div>

        <!-- ===== Main Content ===== -->
        <div class="main-content" id="mainContent">
            <!-- Top Navbar -->
            <nav class="top-navbar">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link sidebar-toggle" id="sidebarToggle" type="button">
                        <i class="bi bi-list"></i>
                    </button>
                    <h5 class="page-title mb-0"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h5>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <!-- Notifications -->
                    <div class="dropdown">
                        <button class="btn btn-icon" data-bs-toggle="dropdown" aria-label="Notifications">
                            <i class="bi bi-bell"></i>
                            <span class="notification-badge">3</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end notification-dropdown">
                            <h6 class="dropdown-header">Notifications</h6>
                            <a class="dropdown-item" href="#"><i class="bi bi-calendar-check text-primary"></i> New appointment booked</a>
                            <a class="dropdown-item" href="#"><i class="bi bi-exclamation-triangle text-warning"></i> Low stock alert</a>
                            <a class="dropdown-item" href="#"><i class="bi bi-clipboard2-pulse text-success"></i> Lab results ready</a>
                        </div>
                    </div>

                    <!-- User Menu -->
                    <div class="dropdown">
                        <button class="btn user-menu-btn" data-bs-toggle="dropdown">
                            <div class="user-avatar">
                                <%= currentUser.full_name ? currentUser.full_name.charAt(0).toUpperCase() : 'U' %>
                            </div>
                            <div class="user-info d-none d-md-block">
                                <span class="user-name"><%= currentUser.full_name %></span>
                                <span class="user-role"><%= currentUser.role_name %></span>
                            </div>
                            <i class="bi bi-chevron-down ms-1"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <div class="dropdown-header">
                                <strong><%= currentUser.full_name %></strong><br>
                                <small class="text-muted"><%= currentUser.role_name %></small>
                            </div>
                            <div class="dropdown-divider"></div>
                            <% if (currentUser.role_name !== 'Administrator') { %>
                            <a class="dropdown-item" href="/auth/profile">
                                <i class="bi bi-person me-2"></i> My Profile
                            </a>
                            <% } else { %>
                            <a class="dropdown-item text-danger fw-semibold" href="/admin">
                                <i class="bi bi-shield-lock-fill me-2"></i> IT Dashboard
                            </a>
                            <% } %>
                            <a class="dropdown-item" href="/auth/change-password">
                                <i class="bi bi-key me-2"></i> Change Password
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item text-danger" href="/auth/logout">
                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                            </a>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Page Content -->
            <div class="page-content p-4">
                <%- body %>
            </div>
        </div>
    <% } else { %>
        <%- body %>
    <% } %>

    <!-- Local Bootstrap JS -->
    <script src="/js/bootstrap.bundle.min.js"></script>

    <!-- Sidebar Toggle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggle = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('sidebar');
            const main = document.getElementById('mainContent');

            if (toggle && sidebar && main) {
                toggle.addEventListener('click', () => {
                    sidebar.classList.toggle('collapsed');
                    main.classList.toggle('expanded');
                });
            }
        });
    </script>
</body>
</html>
