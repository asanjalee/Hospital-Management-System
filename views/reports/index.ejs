<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 print-hide">
    <div>
        <h4 class="fw-bold text-dark mb-1">Reports & Executive Analytics Suite</h4>
        <p class="text-muted mb-0">System-wide performance, revenue metrics, patient demographics, and resource utilization</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" onclick="window.print()" class="btn btn-outline-primary">
            <i class="bi bi-printer me-1"></i> Print / Export PDF
        </button>
    </div>
</div>

<!-- Date Filter Form (Hidden on Print) -->
<div class="card border-0 shadow-sm rounded-3 mb-4 print-hide">
    <div class="card-body p-3">
        <form action="/reports" method="GET" class="row g-3 align-items-end">
            <input type="hidden" name="report" value="<%= activeReport %>">
            <div class="col-12 col-sm-4 col-md-3">
                <label class="form-label fw-bold text-muted small mb-1">FROM DATE</label>
                <input type="date" name="from_date" class="form-control" value="<%= fromDate %>">
            </div>
            <div class="col-12 col-sm-4 col-md-3">
                <label class="form-label fw-bold text-muted small mb-1">TO DATE</label>
                <input type="date" name="to_date" class="form-control" value="<%= toDate %>">
            </div>
            <div class="col-12 col-sm-4 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter me-1"></i> Apply Filter</button>
                <a href="/reports?report=<%= activeReport %>" class="btn btn-light border" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Report Category Tabs (Hidden on Print) -->
<div class="card border-0 shadow-sm rounded-3 mb-4 print-hide">
    <div class="card-header bg-transparent border-0 pt-3 pb-0 px-4">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link <%= activeReport === 'overview' ? 'active fw-bold' : '' %>" href="/reports?report=overview&from_date=<%= fromDate %>&to_date=<%= toDate %>">
                    <i class="bi bi-speedometer2 me-1"></i> Overview
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= activeReport === 'revenue' ? 'active fw-bold' : '' %>" href="/reports?report=revenue&from_date=<%= fromDate %>&to_date=<%= toDate %>">
                    <i class="bi bi-cash-coin me-1"></i> Revenue & Billing
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= activeReport === 'patients' ? 'active fw-bold' : '' %>" href="/reports?report=patients&from_date=<%= fromDate %>&to_date=<%= toDate %>">
                    <i class="bi bi-people-fill me-1"></i> Patients
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= activeReport === 'appointments' ? 'active fw-bold' : '' %>" href="/reports?report=appointments&from_date=<%= fromDate %>&to_date=<%= toDate %>">
                    <i class="bi bi-calendar-check-fill me-1"></i> Appointments
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= activeReport === 'pharmacy' ? 'active fw-bold' : '' %>" href="/reports?report=pharmacy&from_date=<%= fromDate %>&to_date=<%= toDate %>">
                    <i class="bi bi-capsule me-1"></i> Pharmacy
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= activeReport === 'laboratory' ? 'active fw-bold' : '' %>" href="/reports?report=laboratory&from_date=<%= fromDate %>&to_date=<%= toDate %>">
                    <i class="bi bi-droplet-fill me-1"></i> Laboratory
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= activeReport === 'staff' ? 'active fw-bold' : '' %>" href="/reports?report=staff&from_date=<%= fromDate %>&to_date=<%= toDate %>">
                    <i class="bi bi-person-badge-fill me-1"></i> Staff & HR
                </a>
            </li>
        </ul>
    </div>
</div>

<!-- Report Document View -->
<div class="report-container bg-white p-4 rounded-3 shadow-sm border">
    <!-- Official Report Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h3 class="fw-bold text-primary mb-1"><i class="bi bi-hospital me-2"></i> Hospital Management System</h3>
            <p class="text-muted mb-0">Official Executive Report & Analytics Breakdown</p>
        </div>
        <div class="text-end">
            <span class="badge bg-dark px-3 py-2 text-uppercase mb-1"><%= activeReport %> REPORT</span>
            <div class="text-muted small">Generated on: <%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
            <% if (fromDate || toDate) { %>
                <div class="text-primary small fw-semibold">Period: <%= fromDate || 'Beginning' %> to <%= toDate || 'Present' %></div>
            <% } %>
        </div>
    </div>

    <% if (activeReport === 'overview' || activeReport === 'revenue') { %>
        <!-- Financial Summary -->
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-currency-dollar text-primary me-2"></i> Financial & Billing Performance</h5>
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase fw-bold">Gross Amount</small>
                    <h4 class="fw-bold mb-0 text-dark">LKR <%= Number(revenueStats.grossAmount).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></h4>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase fw-bold">Net Revenue</small>
                    <h4 class="fw-bold mb-0 text-primary">LKR <%= Number(revenueStats.netRevenue).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></h4>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase fw-bold">Total Collected (Paid)</small>
                    <h4 class="fw-bold mb-0 text-success">LKR <%= Number(revenueStats.paidAmount).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></h4>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase fw-bold">Unpaid / Outstanding</small>
                    <h4 class="fw-bold mb-0 text-danger">LKR <%= Number(revenueStats.unpaidAmount).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></h4>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-md-6">
                <div class="border rounded-3 p-3 h-100">
                    <h6 class="fw-bold mb-3">Revenue by Payment Method</h6>
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Method</th>
                                <th>Invoices</th>
                                <th class="text-end">Total Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% paymentMethodBreakdown.forEach(pm => { %>
                                <tr>
                                    <td><span class="badge bg-secondary-subtle text-dark"><%= pm.payment_method %></span></td>
                                    <td><%= pm.count %></td>
                                    <td class="text-end fw-bold">LKR <%= Number(pm.total_collected).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="border rounded-3 p-3 h-100">
                    <h6 class="fw-bold mb-3">Revenue Breakdown by Service Type</h6>
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Item Service Type</th>
                                <th>Volume</th>
                                <th class="text-end">Revenue (LKR)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% revenueByItemType.forEach(item => { %>
                                <tr>
                                    <td><span class="badge bg-primary-subtle text-primary"><%= item.item_type %></span></td>
                                    <td><%= item.item_count %></td>
                                    <td class="text-end fw-bold">LKR <%= Number(item.total_revenue).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <% } %>

    <% if (activeReport === 'overview' || activeReport === 'patients') { %>
        <!-- Patient Summary -->
        <h5 class="fw-bold text-dark mb-3 mt-4"><i class="bi bi-people text-primary me-2"></i> Patient Demographics & Registration Summary</h5>
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">TOTAL REGISTERED</small>
                    <h3 class="fw-bold text-dark mb-0"><%= patientStats.total %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">MALE PATIENTS</small>
                    <h3 class="fw-bold text-primary mb-0"><%= patientStats.male %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">FEMALE PATIENTS</small>
                    <h3 class="fw-bold text-danger mb-0"><%= patientStats.female %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">ACTIVE PATIENTS</small>
                    <h3 class="fw-bold text-success mb-0"><%= patientStats.active %></h3>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-md-6">
                <div class="border rounded-3 p-3">
                    <h6 class="fw-bold mb-3">Top Cities / Geographic Distribution</h6>
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>City</th><th class="text-end">Patient Count</th></tr>
                        </thead>
                        <tbody>
                            <% cityDistribution.forEach(c => { %>
                                <tr><td><%= c.city %></td><td class="text-end fw-bold"><%= c.count %></td></tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="border rounded-3 p-3">
                    <h6 class="fw-bold mb-3">Blood Group Distribution</h6>
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Blood Group</th><th class="text-end">Patient Count</th></tr>
                        </thead>
                        <tbody>
                            <% bloodGroupDistribution.forEach(b => { %>
                                <tr><td><span class="badge bg-danger"><%= b.blood_group %></span></td><td class="text-end fw-bold"><%= b.count %></td></tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <% } %>

    <% if (activeReport === 'overview' || activeReport === 'appointments') { %>
        <!-- Appointment Summary -->
        <h5 class="fw-bold text-dark mb-3 mt-4"><i class="bi bi-calendar-check text-primary me-2"></i> Clinical Appointment Statistics</h5>
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">TOTAL APPOINTMENTS</small>
                    <h3 class="fw-bold mb-0"><%= apptStats.total %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">SCHEDULED</small>
                    <h3 class="fw-bold text-warning mb-0"><%= apptStats.scheduled %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">COMPLETED</small>
                    <h3 class="fw-bold text-success mb-0"><%= apptStats.completed %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">CANCELLED</small>
                    <h3 class="fw-bold text-danger mb-0"><%= apptStats.cancelled %></h3>
                </div>
            </div>
        </div>

        <div class="border rounded-3 p-3 mb-4">
            <h6 class="fw-bold mb-3">Top Doctors by Consultation Volume</h6>
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Doctor Name</th>
                        <th>Specialization</th>
                        <th>Department</th>
                        <th class="text-end">Appointments Handled</th>
                    </tr>
                </thead>
                <tbody>
                    <% topDoctorsAppts.forEach(d => { %>
                        <tr>
                            <td class="fw-semibold"><%= d.doctor_name %></td>
                            <td><%= d.specialization %></td>
                            <td><%= d.department_name %></td>
                            <td class="text-end fw-bold"><%= d.appointment_count %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>

    <% if (activeReport === 'overview' || activeReport === 'pharmacy') { %>
        <!-- Pharmacy Summary -->
        <h5 class="fw-bold text-dark mb-3 mt-4"><i class="bi bi-capsule text-primary me-2"></i> Pharmacy Inventory & Stock Control</h5>
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">TOTAL MEDICINES</small>
                    <h3 class="fw-bold mb-0"><%= pharmacyStats.totalMedicines %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">LOW STOCK ALERTS</small>
                    <h3 class="fw-bold text-danger mb-0"><%= pharmacyStats.lowStock %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">EXPIRING IN 60 DAYS</small>
                    <h3 class="fw-bold text-warning mb-0"><%= pharmacyStats.expiringSoon %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">INVENTORY VALUE</small>
                    <h3 class="fw-bold text-success mb-0">LKR <%= Number(pharmacyStats.totalInventoryValue).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></h3>
                </div>
            </div>
        </div>

        <% if (lowStockItems.length > 0) { %>
            <div class="border border-danger-subtle rounded-3 p-3 mb-4 bg-danger-subtle bg-opacity-10">
                <h6 class="fw-bold text-danger mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i> Critical Low Stock Items Requiring Reorder</h6>
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Medicine Name</th>
                            <th>Category</th>
                            <th>Current Stock</th>
                            <th>Reorder Level</th>
                            <th>Unit Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% lowStockItems.forEach(m => { %>
                            <tr>
                                <td><span class="badge bg-secondary font-monospace"><%= m.medicine_code %></span></td>
                                <td class="fw-bold text-dark"><%= m.name %></td>
                                <td><%= m.category %></td>
                                <td><span class="badge bg-danger fs-6"><%= m.stock_quantity %></span></td>
                                <td><%= m.reorder_level %></td>
                                <td>LKR <%= Number(m.unit_price || 0).toFixed(2) %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    <% } %>

    <% if (activeReport === 'overview' || activeReport === 'laboratory') { %>
        <!-- Laboratory Summary -->
        <h5 class="fw-bold text-dark mb-3 mt-4"><i class="bi bi-droplet text-primary me-2"></i> Laboratory Diagnostic Requests</h5>
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">TOTAL REQUESTS</small>
                    <h3 class="fw-bold mb-0"><%= labStats.total %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">PENDING</small>
                    <h3 class="fw-bold text-warning mb-0"><%= labStats.pending %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">IN PROGRESS</small>
                    <h3 class="fw-bold text-info mb-0"><%= labStats.inProgress %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">COMPLETED</small>
                    <h3 class="fw-bold text-success mb-0"><%= labStats.completed %></h3>
                </div>
            </div>
        </div>
    <% } %>

    <% if (activeReport === 'overview' || activeReport === 'staff') { %>
        <!-- Staff Summary -->
        <h5 class="fw-bold text-dark mb-3 mt-4"><i class="bi bi-person-badge text-primary me-2"></i> Staff & Human Resources Utilization</h5>
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">TOTAL STAFF</small>
                    <h3 class="fw-bold mb-0"><%= staffStats.total %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">ACTIVE EMPLOYEES</small>
                    <h3 class="fw-bold text-success mb-0"><%= staffStats.active %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">PRESENT TODAY</small>
                    <h3 class="fw-bold text-primary mb-0"><%= staffStats.presentToday %></h3>
                </div>
            </div>
            <div class="col-12 col-sm-3">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <small class="text-muted fw-bold">PENDING LEAVES</small>
                    <h3 class="fw-bold text-warning mb-0"><%= staffStats.pendingLeaves %></h3>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Report Footer -->
    <div class="mt-5 pt-3 border-top d-flex justify-content-between align-items-center">
        <small class="text-muted">Generated by Hospital Management System &bull; Strictly Confidential</small>
        <small class="text-muted">System Computer-Generated Executive Report</small>
    </div>
</div>
