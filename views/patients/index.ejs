<div class="container-fluid py-2">
    <!-- Top Header & Action Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Patient Directory</h4>
            <p class="text-muted small mb-0">Manage hospital patient records, registration, and medical profiles.</p>
        </div>
        <div>
            <a href="/patients/add" class="btn btn-primary shadow-sm rounded-pill px-4">
                <i class="bi bi-person-plus-fill me-2"></i>Register New Patient
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Filter & Search Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form action="/patients" method="GET" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-start-0" 
                               placeholder="Search by Name, Patient UID (PAT-...), NIC, or Phone..." value="<%= search %>">
                    </div>
                </div>

                <div class="col-md-3">
                    <select name="blood_group" class="form-select bg-light">
                        <option value="">All Blood Groups</option>
                        <% ['A+','A-','B+','B-','AB+','AB-','O+','O-'].forEach(bg => { %>
                            <option value="<%= bg %>" <%= bloodGroup === bg ? 'selected' : '' %>><%= bg %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="gender" class="form-select bg-light">
                        <option value="">All Genders</option>
                        <option value="Male" <%= gender === 'Male' ? 'selected' : '' %>>Male</option>
                        <option value="Female" <%= gender === 'Female' ? 'selected' : '' %>>Female</option>
                        <option value="Other" <%= gender === 'Other' ? 'selected' : '' %>>Other</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter me-1"></i>Filter</button>
                    <% if (search || bloodGroup || gender) { %>
                        <a href="/patients" class="btn btn-outline-secondary" title="Clear Filters"><i class="bi bi-x-circle"></i></a>
                    <% } %>
                </div>
            </form>
        </div>
    </div>

    <!-- Patients Data Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Patient UID</th>
                            <th>Full Name</th>
                            <th>NIC / Passport</th>
                            <th>Gender / DOB</th>
                            <th>Blood Group</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (patients && patients.length > 0) { %>
                            <% patients.forEach(p => { %>
                                <tr>
                                    <td class="ps-4 fw-bold">
                                        <a href="/patients/view/<%= p.patient_uid %>" class="text-decoration-none text-primary">
                                            <i class="bi bi-person-vcard me-1"></i><%= p.patient_uid %>
                                        </a>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center me-2" 
                                                 style="width: 36px; height: 36px; font-size: 0.85rem;">
                                                <%= p.first_name.charAt(0) %><%= p.last_name.charAt(0) %>
                                            </div>
                                            <div>
                                                <a href="/patients/view/<%= p.patient_uid %>" class="fw-semibold text-dark text-decoration-none">
                                                    <%= p.first_name %> <%= p.last_name %>
                                                </a>
                                                <% if (p.city) { %><br><small class="text-muted"><i class="bi bi-geo-alt me-1"></i><%= p.city %></small><% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="font-monospace small text-muted"><%= p.nic_number || 'N/A' %></span></td>
                                    <td>
                                        <%= p.gender || 'N/A' %>
                                        <% if (p.date_of_birth) { %>
                                            <br><small class="text-muted"><%= p.date_of_birth %></small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (p.blood_group) { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-droplet-fill me-1"></i><%= p.blood_group %>
                                            </span>
                                        <% } else { %>
                                            <span class="text-muted small">N/A</span>
                                        <% } %>
                                    </td>
                                    <td><%= p.phone || 'N/A' %></td>
                                    <td>
                                        <% if (p.is_active === 1) { %>
                                            <span class="badge bg-success-subtle text-success px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1"><i class="bi bi-dash-circle-fill me-1"></i>Inactive</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/patients/view/<%= p.patient_uid %>" class="btn btn-outline-primary" title="View Profile & Medical History">
                                                <i class="bi bi-folder2-open me-1"></i>View
                                            </a>
                                            <a href="/patients/edit/<%= p.id %>" class="btn btn-outline-secondary" title="Edit Patient Info">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-person-exclamation fs-1 d-block mb-2"></i>
                                        <h5>No Patients Found</h5>
                                        <p class="small mb-3">Try refining your search filters or add a new patient record.</p>
                                        <a href="/patients/add" class="btn btn-sm btn-primary rounded-pill px-3">
                                            <i class="bi bi-plus-circle me-1"></i>Register Patient
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-top p-3 text-muted small d-flex justify-content-between align-items-center">
            <span>Showing <strong><%= patients ? patients.length : 0 %></strong> registered patient records</span>
            <span>Hospital Management System • Patient Directory</span>
        </div>
    </div>
</div>
