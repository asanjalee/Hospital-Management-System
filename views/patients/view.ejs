<div class="container-fluid py-2">
    <!-- Navigation & Action Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <a href="/patients" class="btn btn-sm btn-outline-secondary rounded-pill mb-2">
                <i class="bi bi-arrow-left me-1"></i>Back to Directory
            </a>
            <h4 class="fw-bold mb-0">
                <i class="bi bi-person-vcard text-primary me-2"></i>Patient Profile
            </h4>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#addRecordModal">
                <i class="bi bi-journal-plus me-2"></i>Add Clinical Visit
            </button>
            <a href="/patients/edit/<%= patient.id %>" class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-pencil-square me-1"></i>Edit Profile
            </a>
            <form action="/patients/toggle-status/<%= patient.id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to change this patient status?')">
                <button type="submit" class="btn <%= patient.is_active === 1 ? 'btn-outline-danger' : 'btn-outline-success' %> rounded-pill">
                    <i class="bi <%= patient.is_active === 1 ? 'bi-person-x' : 'bi-person-check' %> me-1"></i>
                    <%= patient.is_active === 1 ? 'Deactivate' : 'Activate' %>
                </button>
            </form>
        </div>
    </div>

    <!-- Alert Messages -->
    <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Patient Overview Banner Card -->
    <div class="card border-0 shadow-sm mb-4 bg-white overflow-hidden">
        <div class="card-body p-4">
            <div class="row align-items-center g-4">
                <div class="col-auto">
                    <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center shadow" 
                         style="width: 80px; height: 80px; font-size: 2rem;">
                        <%= patient.first_name.charAt(0) %><%= patient.last_name.charAt(0) %>
                    </div>
                </div>
                <div class="col">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h3 class="fw-bold mb-0"><%= patient.first_name %> <%= patient.last_name %></h3>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 font-monospace">
                            <%= patient.patient_uid %>
                        </span>
                        <% if (patient.is_active === 1) { %>
                            <span class="badge bg-success-subtle text-success px-2 py-1"><i class="bi bi-circle-fill me-1 small"></i>Active Patient</span>
                        <% } else { %>
                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1"><i class="bi bi-circle-fill me-1 small"></i>Inactive</span>
                        <% } %>
                    </div>

                    <div class="row text-muted small mt-3 g-2">
                        <div class="col-6 col-md-3">
                            <i class="bi bi-gender-ambiguous text-primary me-1"></i><strong>Gender:</strong> <%= patient.gender || 'N/A' %>
                        </div>
                        <div class="col-6 col-md-3">
                            <i class="bi bi-calendar3 text-primary me-1"></i><strong>Age:</strong> <%= patient.age %> yrs (<%= patient.date_of_birth || 'N/A' %>)
                        </div>
                        <div class="col-6 col-md-3">
                            <i class="bi bi-card-heading text-primary me-1"></i><strong>NIC:</strong> <%= patient.nic_number || 'N/A' %>
                        </div>
                        <div class="col-6 col-md-3">
                            <i class="bi bi-telephone text-primary me-1"></i><strong>Phone:</strong> <%= patient.phone || 'N/A' %>
                        </div>
                    </div>
                </div>

                <div class="col-md-auto text-md-end border-start ps-md-4">
                    <div class="mb-2">
                        <small class="text-muted d-block">Blood Group</small>
                        <% if (patient.blood_group) { %>
                            <span class="badge bg-danger fs-5 px-3 py-2">
                                <i class="bi bi-droplet-fill me-1"></i><%= patient.blood_group %>
                            </span>
                        <% } else { %>
                            <span class="badge bg-secondary">N/A</span>
                        <% } %>
                    </div>
                    <% if (patient.allergies) { %>
                        <div class="mt-2">
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1" title="Known Allergies">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i><%= patient.allergies %>
                            </span>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4 gap-2 border-bottom pb-3" id="patientTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">
                <i class="bi bi-journal-medical me-2"></i>Medical History (<%= medicalRecords.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="appointments-tab" data-bs-toggle="tab" data-bs-target="#appointments" type="button" role="tab">
                <i class="bi bi-calendar-check me-2"></i>Appointments (<%= appointments.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="billing-tab" data-bs-toggle="tab" data-bs-target="#billing" type="button" role="tab">
                <i class="bi bi-receipt me-2"></i>Billing & Invoices (<%= invoices.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab">
                <i class="bi bi-person-lines-fill me-2"></i>Full Demographics
            </button>
        </li>
    </ul>

    <!-- Tab Content Panels -->
    <div class="tab-content" id="patientTabsContent">
        <!-- TAB 1: MEDICAL HISTORY -->
        <div class="tab-pane fade show active" id="history" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0 text-muted"><i class="bi bi-clock-history me-2"></i>Clinical Visits & Medical History Timeline</h6>
                <button class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#addRecordModal">
                    <i class="bi bi-plus-circle me-1"></i>New Record
                </button>
            </div>

            <% if (medicalRecords && medicalRecords.length > 0) { %>
                <div class="timeline position-relative">
                    <% medicalRecords.forEach((record, index) => { %>
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary rounded-circle p-2"><i class="bi bi-stethoscope"></i></span>
                                    <h6 class="fw-bold mb-0 text-dark">Diagnosis: <%= record.diagnosis %></h6>
                                </div>
                                <span class="badge bg-light text-muted border px-3 py-1 font-monospace">
                                    <i class="bi bi-calendar-event me-1"></i><%= record.visit_date %>
                                </span>
                            </div>
                            <div class="card-body p-4">
                                <!-- Vitals Strip -->
                                <% if (record.vitals_bp || record.vitals_pulse || record.vitals_temp || record.vitals_weight) { %>
                                    <div class="bg-light rounded p-3 mb-3">
                                        <div class="row text-center g-2">
                                            <div class="col">
                                                <small class="text-muted d-block">Blood Pressure</small>
                                                <strong class="text-primary"><i class="bi bi-activity me-1"></i><%= record.vitals_bp || 'N/A' %></strong>
                                            </div>
                                            <div class="col border-start">
                                                <small class="text-muted d-block">Pulse Rate</small>
                                                <strong class="text-danger"><i class="bi bi-heart-pulse me-1"></i><%= record.vitals_pulse ? record.vitals_pulse + ' bpm' : 'N/A' %></strong>
                                            </div>
                                            <div class="col border-start">
                                                <small class="text-muted d-block">Body Temp</small>
                                                <strong class="text-warning"><i class="bi bi-thermometer-half me-1"></i><%= record.vitals_temp ? record.vitals_temp + ' °F' : 'N/A' %></strong>
                                            </div>
                                            <div class="col border-start">
                                                <small class="text-muted d-block">Weight</small>
                                                <strong class="text-success"><i class="bi bi-speedometer2 me-1"></i><%= record.vitals_weight ? record.vitals_weight + ' kg' : 'N/A' %></strong>
                                            </div>
                                        </div>
                                    </div>
                                <% } %>

                                <div class="row g-3">
                                    <% if (record.symptoms) { %>
                                        <div class="col-md-6">
                                            <strong class="small text-muted d-block mb-1">Symptoms Reported:</strong>
                                            <p class="mb-0 text-dark"><%= record.symptoms %></p>
                                        </div>
                                    <% } %>
                                    <% if (record.treatment_plan) { %>
                                        <div class="col-md-6">
                                            <strong class="small text-muted d-block mb-1">Treatment Plan:</strong>
                                            <p class="mb-0 text-dark"><%= record.treatment_plan %></p>
                                        </div>
                                    <% } %>
                                    <% if (record.prescription) { %>
                                        <div class="col-12 mt-2">
                                            <strong class="small text-muted d-block mb-1"><i class="bi bi-capsule text-primary me-1"></i>Prescribed Medication:</strong>
                                            <div class="p-3 bg-primary-subtle text-primary-emphasis rounded border border-primary-subtle">
                                                <pre class="mb-0 font-monospace small" style="white-space: pre-wrap;"><%= record.prescription %></pre>
                                            </div>
                                        </div>
                                    <% } %>
                                    <% if (record.doctor_notes) { %>
                                        <div class="col-12 mt-2">
                                            <strong class="small text-muted d-block mb-1">Clinical Notes:</strong>
                                            <p class="text-muted mb-0 small fst-italic"><%= record.doctor_notes %></p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                            <div class="card-footer bg-white border-top text-muted small d-flex justify-content-between">
                                <span>Attending Doctor: <strong><%= record.doctor_name || 'General Medical Staff' %></strong></span>
                                <span>Record ID: #<%= record.id %></span>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="card border-0 shadow-sm text-center py-5">
                    <div class="card-body text-muted">
                        <i class="bi bi-journal-medical fs-1 d-block mb-2 text-primary opacity-50"></i>
                        <h5>No Medical Records Logged Yet</h5>
                        <p class="small mb-3">Click below to record clinical diagnosis, vitals, and treatment plans.</p>
                        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addRecordModal">
                            <i class="bi bi-plus-circle me-1"></i>Add First Medical Record
                        </button>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- TAB 2: APPOINTMENTS HISTORY -->
        <div class="tab-pane fade" id="appointments" role="tabpanel">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Appt #</th>
                                    <th>Doctor</th>
                                    <th>Department</th>
                                    <th>Date & Time</th>
                                    <th>Reason</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (appointments && appointments.length > 0) { %>
                                    <% appointments.forEach(a => { %>
                                        <tr>
                                            <td class="ps-4 fw-bold"><%= a.appointment_number %></td>
                                            <td><%= a.doctor_name || 'Assigned Doctor' %></td>
                                            <td><%= a.department_name || 'General' %></td>
                                            <td><%= a.appointment_date %> at <%= a.appointment_time %></td>
                                            <td><%= a.reason || 'General Consultation' %></td>
                                            <td>
                                                <span class="badge bg-primary-subtle text-primary px-2 py-1"><%= a.status %></span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            No appointments scheduled or recorded for this patient.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: BILLING & INVOICES -->
        <div class="tab-pane fade" id="billing" role="tabpanel">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Invoice #</th>
                                    <th>Date</th>
                                    <th>Net Amount</th>
                                    <th>Paid Amount</th>
                                    <th>Status</th>
                                    <th>Method</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (invoices && invoices.length > 0) { %>
                                    <% invoices.forEach(inv => { %>
                                        <tr>
                                            <td class="ps-4 fw-bold"><%= inv.invoice_number %></td>
                                            <td><%= inv.invoice_date %></td>
                                            <td class="fw-bold">Rs. <%= Number(inv.net_amount || 0).toFixed(2) %></td>
                                            <td class="text-success">Rs. <%= Number(inv.paid_amount || 0).toFixed(2) %></td>
                                            <td>
                                                <span class="badge <%= inv.payment_status === 'Paid' ? 'bg-success' : 'bg-warning text-dark' %> px-2 py-1">
                                                    <%= inv.payment_status %>
                                                </span>
                                            </td>
                                            <td><%= inv.payment_method || 'N/A' %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            No billing invoices recorded for this patient.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 4: DEMOGRAPHICS -->
        <div class="tab-pane fade" id="profile" role="tabpanel">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-person-lines-fill me-2"></i>Personal & Identification Information</h6>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm table-borderless mb-0">
                                <tr><th class="text-muted w-40">Patient UID:</th><td class="fw-bold"><%= patient.patient_uid %></td></tr>
                                <tr><th class="text-muted">Full Name:</th><td><%= patient.first_name %> <%= patient.last_name %></td></tr>
                                <tr><th class="text-muted">Date of Birth:</th><td><%= patient.date_of_birth || 'Not Specified' %></td></tr>
                                <tr><th class="text-muted">Gender:</th><td><%= patient.gender %></td></tr>
                                <tr><th class="text-muted">NIC / Passport:</th><td><%= patient.nic_number || 'N/A' %></td></tr>
                                <tr><th class="text-muted">Blood Group:</th><td><%= patient.blood_group || 'N/A' %></td></tr>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-geo-alt-fill me-2"></i>Contact & Emergency Details</h6>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm table-borderless mb-0">
                                <tr><th class="text-muted w-40">Phone Number:</th><td><%= patient.phone || 'N/A' %></td></tr>
                                <tr><th class="text-muted">Email Address:</th><td><%= patient.email || 'N/A' %></td></tr>
                                <tr><th class="text-muted">Address:</th><td><%= patient.address || 'N/A' %></td></tr>
                                <tr><th class="text-muted">City:</th><td><%= patient.city || 'N/A' %></td></tr>
                                <tr><th class="text-muted">Emergency Person:</th><td><%= patient.emergency_contact || 'N/A' %></td></tr>
                                <tr><th class="text-muted">Emergency Phone:</th><td class="text-danger fw-bold"><%= patient.emergency_phone || 'N/A' %></td></tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== MODAL: ADD MEDICAL HISTORY RECORD ===== -->
<div class="modal fade" id="addRecordModal" tabindex="-1" aria-labelledby="addRecordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="addRecordModalLabel">
                    <i class="bi bi-journal-plus me-2"></i>Log Clinical Visit & Medical Record
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/patients/medical-history/add" method="POST">
                <input type="hidden" name="patient_id" value="<%= patient.id %>">
                
                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label required">Visit Date <span class="text-danger">*</span></label>
                            <input type="date" name="visit_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Attending Doctor</label>
                            <select name="doctor_id" class="form-select">
                                <option value="">Select Doctor (Optional)</option>
                                <% if (doctors && doctors.length > 0) { %>
                                    <% doctors.forEach(doc => { %>
                                        <option value="<%= doc.id %>"><%= doc.full_name %> (<%= doc.specialization %>)</option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                    </div>

                    <!-- Vitals Section -->
                    <div class="card bg-light border-0 mb-3">
                        <div class="card-body p-3">
                            <h6 class="fw-bold mb-2 text-primary small text-uppercase"><i class="bi bi-activity me-1"></i>Patient Vital Signs</h6>
                            <div class="row g-2">
                                <div class="col-6 col-md-3">
                                    <label class="form-label small mb-1">Blood Pressure</label>
                                    <input type="text" name="vitals_bp" class="form-control form-control-sm" placeholder="120/80">
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label small mb-1">Pulse (bpm)</label>
                                    <input type="number" name="vitals_pulse" class="form-control form-control-sm" placeholder="72">
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label small mb-1">Temp (°F)</label>
                                    <input type="number" step="0.1" name="vitals_temp" class="form-control form-control-sm" placeholder="98.6">
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label small mb-1">Weight (kg)</label>
                                    <input type="number" step="0.1" name="vitals_weight" class="form-control form-control-sm" placeholder="70.5">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Clinical Diagnosis & Details -->
                    <div class="mb-3">
                        <label class="form-label required">Primary Diagnosis <span class="text-danger">*</span></label>
                        <input type="text" name="diagnosis" class="form-control" placeholder="e.g. Acute Bronchitis, Type 2 Diabetes..." required>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Symptoms Reported</label>
                            <textarea name="symptoms" class="form-control" rows="2" placeholder="Fever, cough, fatigue for 3 days..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Treatment Plan</label>
                            <textarea name="treatment_plan" class="form-control" rows="2" placeholder="Rest, hydration, follow-up in 7 days..."></textarea>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Prescribed Medication / Rx</label>
                        <textarea name="prescription" class="form-control font-monospace" rows="3" placeholder="1. Amoxicillin 500mg - 1 tab TDS x 5 days&#10;2. Paracetamol 500mg - 2 tab PRN"></textarea>
                    </div>

                    <div class="mb-0">
                        <label class="form-label">Doctor's Private Clinical Notes</label>
                        <textarea name="doctor_notes" class="form-control" rows="2" placeholder="Confidential clinical notes..."></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-check-circle-fill me-1"></i>Save Medical Record
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
