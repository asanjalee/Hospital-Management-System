<div class="container-fluid py-2">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <a href="/patients" class="btn btn-sm btn-outline-secondary rounded-pill mb-2">
                <i class="bi bi-arrow-left me-1"></i>Back to Directory
            </a>
            <h4 class="fw-bold mb-0"><i class="bi bi-person-plus-fill text-primary me-2"></i>Register New Patient</h4>
        </div>
        <div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6">
                Auto-UID: <strong><%= patientUID %></strong>
            </span>
        </div>
    </div>

    <!-- Error Validation Alert -->
    <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please resolve the following errors:</h6>
            <ul class="mb-0 ps-3 small">
                <% errors.forEach(e => { %>
                    <li><%= e.msg %></li>
                <% }) %>
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <form action="/patients/add" method="POST" class="needs-validation" novalidate>
        <input type="hidden" name="patient_uid" value="<%= patientUID %>">

        <div class="row g-4">
            <!-- Section 1: Demographics & Personal Information -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                        <i class="bi bi-person-lines-fill text-primary me-2 fs-5"></i>
                        <h6 class="fw-bold mb-0">Demographics & Personal Details</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label required">First Name <span class="text-danger">*</span></label>
                                <input type="text" name="first_name" class="form-control" placeholder="e.g. John" 
                                       value="<%= formData.first_name || '' %>" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label required">Last Name <span class="text-danger">*</span></label>
                                <input type="text" name="last_name" class="form-control" placeholder="e.g. Doe" 
                                       value="<%= formData.last_name || '' %>" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Date of Birth</label>
                                <input type="date" name="date_of_birth" class="form-control" 
                                       value="<%= formData.date_of_birth || '' %>">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label required">Gender <span class="text-danger">*</span></label>
                                <select name="gender" class="form-select" required>
                                    <option value="">Select Gender</option>
                                    <option value="Male" <%= formData.gender === 'Male' ? 'selected' : '' %>>Male</option>
                                    <option value="Female" <%= formData.gender === 'Female' ? 'selected' : '' %>>Female</option>
                                    <option value="Other" <%= formData.gender === 'Other' ? 'selected' : '' %>>Other</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Blood Group</label>
                                <select name="blood_group" class="form-select">
                                    <option value="">Select Blood Group</option>
                                    <% ['A+','A-','B+','B-','AB+','AB-','O+','O-'].forEach(bg => { %>
                                        <option value="<%= bg %>" <%= formData.blood_group === bg ? 'selected' : '' %>><%= bg %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">NIC / Passport Number</label>
                                <input type="text" name="nic_number" class="form-control" placeholder="e.g. 199012345678 or V123456" 
                                       value="<%= formData.nic_number || '' %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone Number</label>
                                <input type="tel" name="phone" class="form-control" placeholder="e.g. +94 77 1234567" 
                                       value="<%= formData.phone || '' %>">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Address & Contact Details -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                        <i class="bi bi-geo-alt-fill text-primary me-2 fs-5"></i>
                        <h6 class="fw-bold mb-0">Contact & Location Info</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Email Address</label>
                                <input type="email" name="email" class="form-control" placeholder="e.g. patient@email.com" 
                                       value="<%= formData.email || '' %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">City / Town</label>
                                <input type="text" name="city" class="form-control" placeholder="e.g. Colombo" 
                                       value="<%= formData.city || '' %>">
                            </div>
                            <div class="col-12">
                                <label class="form-label">Residential Address</label>
                                <textarea name="address" class="form-control" rows="2" placeholder="Full residential street address..."><%= formData.address || '' %></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Emergency Contact & Medical History Notes -->
            <div class="col-lg-4">
                <!-- Emergency Contact -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                        <i class="bi bi-telephone-fill text-danger me-2 fs-5"></i>
                        <h6 class="fw-bold mb-0">Emergency Contact</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label">Contact Person Name</label>
                            <input type="text" name="emergency_contact" class="form-control" placeholder="e.g. Mary Doe (Spouse)" 
                                   value="<%= formData.emergency_contact || '' %>">
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Emergency Phone</label>
                            <input type="tel" name="emergency_phone" class="form-control" placeholder="e.g. +94 71 9876543" 
                                   value="<%= formData.emergency_phone || '' %>">
                        </div>
                    </div>
                </div>

                <!-- Medical Background & Allergies -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                        <i class="bi bi-heart-pulse-fill text-warning me-2 fs-5"></i>
                        <h6 class="fw-bold mb-0">Medical Background</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label">Known Allergies</label>
                            <textarea name="allergies" class="form-control" rows="2" placeholder="Penicillin, Dust, Peanuts..."><%= formData.allergies || '' %></textarea>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Initial Medical Notes</label>
                            <textarea name="medical_notes" class="form-control" rows="3" placeholder="Chronic conditions, past surgeries, medical alerts..."><%= formData.medical_notes || '' %></textarea>
                        </div>
                    </div>
                </div>

                <!-- Submit Action Card -->
                <div class="card border-0 shadow-sm bg-light">
                    <div class="card-body p-3 text-center">
                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill mb-2 shadow-sm">
                            <i class="bi bi-check-circle-fill me-2"></i>Save & Register Patient
                        </button>
                        <a href="/patients" class="btn btn-outline-secondary w-100 rounded-pill">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
