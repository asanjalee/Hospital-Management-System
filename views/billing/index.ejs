<!-- Billing & Invoice Directory View -->
<div class="container-fluid px-0">

    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Header Banner & Action -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-receipt-cutoff text-success me-2"></i>Billing & Patient Invoicing
            </h3>
            <p class="text-muted mb-0">Consultation fees, lab test charges, pharmacy medication billing, itemized receipt generation, and payment recording</p>
        </div>
        <div>
            <a href="/billing/create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium">
                <i class="bi bi-plus-circle-fill fs-5"></i>
                <span>Generate New Invoice</span>
            </a>
        </div>
    </div>

    <!-- Metric KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-file-earmark-spreadsheet fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Total Invoices</div>
                        <h4 class="fw-bold mb-0 text-dark"><%= stats.totalCount %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-cash-stack fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Total Billed Net Revenue</div>
                        <h4 class="fw-bold mb-0 text-success">LKR <%= (stats.totalRevenue || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Total Collected Revenue</div>
                        <h4 class="fw-bold mb-0 text-info">LKR <%= (stats.paidRevenue || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Outstanding Unpaid</div>
                        <h4 class="fw-bold mb-0 text-danger">LKR <%= (stats.unpaidAmount || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %></h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <form action="/billing" method="GET" class="row g-2 align-items-center">
                <div class="col-12 col-md-7">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-start-0 ps-0" placeholder="Search Invoice ID, patient UID or patient name..." value="<%= search %>">
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <select name="status" class="form-select bg-light">
                        <option value="">All Payment Statuses</option>
                        <option value="Paid" <%= status === 'Paid' ? 'selected' : '' %>>Paid</option>
                        <option value="Partially Paid" <%= status === 'Partially Paid' ? 'selected' : '' %>>Partially Paid</option>
                        <option value="Unpaid" <%= status === 'Unpaid' ? 'selected' : '' %>>Unpaid</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-medium">Filter</button>
                    <a href="/billing" class="btn btn-outline-secondary px-3" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Invoices Table -->
    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="card-body p-0">
            <% if (invoices && invoices.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Invoice ID</th>
                                <th>Patient</th>
                                <th>Invoice Date</th>
                                <th>Net Payable (LKR)</th>
                                <th>Paid Amount (LKR)</th>
                                <th>Payment Method</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% invoices.forEach(inv => { %>
                                <tr>
                                    <td class="ps-3">
                                        <a href="/billing/invoice/<%= inv.id %>" class="fw-bold font-monospace text-primary text-decoration-none">
                                            <%= inv.invoice_number %>
                                        </a>
                                    </td>
                                    <td>
                                        <a href="/patients/view/<%= inv.patient_uid %>" class="text-dark fw-bold text-decoration-none">
                                            <%= inv.patient_first_name %> <%= inv.patient_last_name %>
                                        </a>
                                        <div class="small text-muted"><i class="bi bi-card-text me-1"></i><%= inv.patient_uid %></div>
                                    </td>
                                    <td>
                                        <div class="small text-dark fw-semibold"><i class="bi bi-calendar3 me-1 text-primary"></i><%= inv.invoice_date %></div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">LKR <%= Number(inv.net_amount || 0).toFixed(2) %></span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">LKR <%= Number(inv.paid_amount || 0).toFixed(2) %></span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1"><%= inv.payment_method || 'Unspecified' %></span>
                                    </td>
                                    <td>
                                        <% if (inv.payment_status === 'Paid') { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-semibold">Paid</span>
                                        <% } else if (inv.payment_status === 'Partially Paid') { %>
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 fw-semibold">Partially Paid</span>
                                        <% } else { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-semibold">Unpaid</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end pe-3">
                                        <a href="/billing/invoice/<%= inv.id %>" class="btn btn-sm btn-outline-primary fw-medium me-1">
                                            <i class="bi bi-receipt me-1"></i> View Receipt
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-receipt display-4 mb-3 text-secondary d-block"></i>
                    <h5 class="fw-bold text-dark mb-1">No Invoices Found</h5>
                    <p class="text-muted mb-3">No patient billing records matched your filter criteria.</p>
                    <a href="/billing/create" class="btn btn-primary fw-medium px-4">Generate New Invoice</a>
                </div>
            <% } %>
        </div>
    </div>

</div>
