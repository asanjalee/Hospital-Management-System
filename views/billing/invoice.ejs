<!-- Printable Invoice / Official Hospital Receipt View -->
<div class="container-fluid px-0">

    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4 d-print-none" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4 d-print-none" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Header Navigation Actions (Hidden during print) -->
    <div class="d-flex align-items-center justify-content-between mb-3 d-print-none flex-wrap gap-2">
        <div>
            <a href="/billing" class="text-decoration-none text-muted small fw-medium mb-1 d-inline-block">
                <i class="bi bi-arrow-left me-1"></i> Back to Billing Directory
            </a>
            <h3 class="fw-bold mb-0 text-dark">Invoice <%= invoice.invoice_number %></h3>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="form-check form-switch bg-white border px-3 py-2 rounded-3 shadow-sm mb-0">
                <input class="form-check-input ms-0 me-2" type="checkbox" id="toggleSignatureBilling" checked onchange="document.querySelectorAll('.signature-block').forEach(el => el.style.display = this.checked ? 'flex' : 'none')">
                <label class="form-check-label small fw-semibold text-dark" for="toggleSignatureBilling">
                    <i class="bi bi-pen me-1 text-primary"></i> Include Signature Lines
                </label>
            </div>
            <button onclick="window.print()" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium">
                <i class="bi bi-printer-fill fs-5"></i>
                <span>Print Official Receipt</span>
            </button>
        </div>
    </div>

    <!-- Official Printable Receipt Card -->
    <div class="card border-0 shadow-sm rounded-3 bg-white mb-4 p-3 p-md-4 d-flex flex-column justify-content-between printable-page-container" id="printableReceipt">
        <div>
            <!-- Hospital Branding & Receipt Header -->
            <div class="row align-items-center mb-3 pb-3 border-bottom printable-header">
                <div class="col-7">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-primary text-white p-2 p-md-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-hospital fs-3"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold text-dark mb-0">ST. GEORGE GENERAL HOSPITAL</h4>
                            <p class="text-muted small mb-0">124 Healthcare Boulevard, Colombo 03, Sri Lanka</p>
                            <p class="text-muted small mb-0">Tel: +94 11 2345678 | Email: billing@stgeorgehospital.lk</p>
                        </div>
                    </div>
                </div>
                <div class="col-5 text-end">
                    <h3 class="fw-bold text-primary mb-0">INVOICE / RECEIPT</h3>
                    <div class="fs-6 fw-bold text-dark font-monospace"><%= invoice.invoice_number %></div>
                    <div class="text-muted small">Issued Date: <strong><%= invoice.invoice_date %></strong></div>
                    <div class="mt-1">
                        <% if (invoice.payment_status === 'Paid') { %>
                            <span class="badge bg-success px-2 py-1 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> FULLY PAID</span>
                        <% } else if (invoice.payment_status === 'Partially Paid') { %>
                            <span class="badge bg-warning text-dark px-2 py-1 rounded-pill"><i class="bi bi-hourglass-split me-1"></i> PARTIALLY PAID</span>
                        <% } else { %>
                            <span class="badge bg-danger px-2 py-1 rounded-pill"><i class="bi bi-exclamation-octagon-fill me-1"></i> UNPAID</span>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Billed To & Context Info -->
            <div class="row g-3 mb-3 p-3 bg-light rounded-3 printable-context">
                <div class="col-6">
                    <div class="small text-muted mb-1 text-uppercase fw-semibold">Billed To (Patient Details):</div>
                    <h6 class="fw-bold text-dark mb-0"><%= invoice.patient_first_name %> <%= invoice.patient_last_name %></h6>
                    <div class="small text-dark"><strong>Patient UID:</strong> <%= invoice.patient_uid %></div>
                    <div class="small text-muted">Address: <%= invoice.address || 'Colombo' %>, <%= invoice.city || '' %> &bull; Phone: <%= invoice.patient_phone || 'N/A' %></div>
                </div>
                <div class="col-6 text-end">
                    <div class="small text-muted mb-1 text-uppercase fw-semibold">Consultation Context:</div>
                    <% if (invoice.doctor_name) { %>
                        <div class="fw-bold text-dark small"><%= invoice.doctor_name %></div>
                    <% } %>
                    <% if (invoice.appointment_number) { %>
                        <div class="small text-muted">Appt Reference: <strong><%= invoice.appointment_number %></strong></div>
                    <% } %>
                    <div class="small text-muted">Generated By: <strong><%= invoice.creator_name || 'System Admin' %></strong></div>
                </div>
            </div>

            <!-- Itemized Charges Table -->
            <div class="table-responsive mb-3">
                <table class="table table-bordered align-middle mb-0 printable-table">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-2" style="width: 5%;">#</th>
                            <th style="width: 20%;">Category</th>
                            <th style="width: 45%;">Item Description</th>
                            <th class="text-center" style="width: 10%;">Qty</th>
                            <th class="text-end" style="width: 10%;">Unit Price</th>
                            <th class="text-end pe-2" style="width: 10%;">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (items && items.length > 0) { %>
                            <% items.forEach((item, index) => { %>
                                <tr>
                                    <td class="ps-2 fw-bold text-muted"><%= index + 1 %></td>
                                    <td><span class="badge bg-light text-dark border py-1 px-2"><%= item.item_type %></span></td>
                                    <td class="fw-semibold text-dark"><%= item.description %></td>
                                    <td class="text-center"><%= item.quantity %></td>
                                    <td class="text-end">LKR <%= item.unit_price.toFixed(2) %></td>
                                    <td class="text-end pe-2 fw-bold">LKR <%= item.amount.toFixed(2) %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td class="ps-2 fw-bold text-muted">1</td>
                                <td><span class="badge bg-light text-dark border py-1 px-2">General</span></td>
                                <td class="fw-semibold text-dark">Hospital Consultation & Clinical Services</td>
                                <td class="text-center">1</td>
                                <td class="text-end">LKR <%= invoice.total_amount.toFixed(2) %></td>
                                <td class="text-end pe-2 fw-bold">LKR <%= invoice.total_amount.toFixed(2) %></td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Financial Summary Totals -->
            <div class="row justify-content-end mb-3">
                <div class="col-12 col-md-5">
                    <div class="p-2 p-md-3 bg-light rounded-3 printable-totals">
                        <div class="d-flex justify-content-between mb-1 small">
                            <span class="text-muted">Gross Total Amount:</span>
                            <span class="fw-bold text-dark">LKR <%= invoice.total_amount.toFixed(2) %></span>
                        </div>
                        <% if (invoice.discount_amount > 0) { %>
                            <div class="d-flex justify-content-between mb-1 small">
                                <span class="text-muted">Discount Applied:</span>
                                <span class="fw-bold text-danger">- LKR <%= invoice.discount_amount.toFixed(2) %></span>
                            </div>
                        <% } %>
                        <div class="d-flex justify-content-between border-top border-bottom py-1 my-1 fs-6">
                            <span class="fw-bold text-dark">Net Total Amount:</span>
                            <span class="fw-bold text-primary">LKR <%= invoice.net_amount.toFixed(2) %></span>
                        </div>
                        <div class="d-flex justify-content-between mb-1 small">
                            <span class="text-muted">Amount Paid:</span>
                            <span class="fw-bold text-success">LKR <%= invoice.paid_amount.toFixed(2) %></span>
                        </div>
                        <div class="d-flex justify-content-between small fw-bold">
                            <span class="text-dark">Balance Due:</span>
                            <span class="<%= (invoice.net_amount - invoice.paid_amount) > 0 ? 'text-danger' : 'text-success' %>">
                                LKR <%= Math.max(0, invoice.net_amount - invoice.paid_amount).toFixed(2) %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Action Modal Form for Cashier (Hidden when printing) -->
            <% if (invoice.payment_status !== 'Paid') { %>
                <div class="card border border-warning shadow-sm rounded-3 mb-3 d-print-none">
                    <div class="card-header bg-warning bg-opacity-10 border-bottom border-warning p-2 px-3">
                        <h6 class="fw-bold mb-0 text-warning-emphasis"><i class="bi bi-credit-card-fill me-2"></i>Record Payment Entry</h6>
                    </div>
                    <div class="card-body p-3">
                        <form action="/billing/payment/<%= invoice.id %>" method="POST" class="row g-2 align-items-end">
                            <div class="col-12 col-md-4">
                                <label for="amount" class="form-label fw-semibold text-dark small mb-1">Payment Amount (LKR)</label>
                                <input type="number" step="0.01" id="amount" name="amount" class="form-control fw-bold text-success" value="<%= (invoice.net_amount - invoice.paid_amount).toFixed(2) %>" required>
                            </div>
                            <div class="col-12 col-md-4">
                                <label for="payment_method" class="form-label fw-semibold text-dark small mb-1">Payment Method</label>
                                <select id="payment_method" name="payment_method" class="form-select">
                                    <option value="Cash" selected>Cash</option>
                                    <option value="Credit/Debit Card">Credit/Debit Card</option>
                                    <option value="Bank Transfer">Bank Transfer</option>
                                    <option value="Insurance Claim">Insurance Claim</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-4">
                                <button type="submit" class="btn btn-success w-100 fw-medium">
                                    <i class="bi bi-check-circle-fill me-1"></i> Complete Payment
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            <% } %>

            <!-- Signature Section (Spaced Flex Layout) -->
            <div class="signature-block my-4 pt-3">
                <div class="signature-item">
                    <div class="signature-line">
                        <div class="small fw-bold text-dark">Patient / Representative Signature</div>
                    </div>
                </div>
                <div class="signature-item">
                    <div class="signature-line">
                        <div class="small fw-bold text-dark">Authorized Cashier Stamp & Signature</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Strict Bottom Footer Watermark Notice -->
        <div class="printable-footer pt-2 border-top text-center text-muted small mt-auto">
            <i class="bi bi-shield-check text-success me-1"></i> System Computer-Generated Receipt &bull; St. George Hospital Billing System &bull; Valid Without Physical Signature
        </div>

    </div>

</div>
