<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold text-dark mb-1">Staff & Human Resources Management</h4>
        <p class="text-muted mb-0">Manage hospital staff directory, daily attendance tracking, and leave applications</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#markAttendanceModal">
            <i class="bi bi-clock-history me-1"></i> Mark Attendance
        </button>
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#applyLeaveModal">
            <i class="bi bi-calendar-plus me-1"></i> Apply Leave
        </button>
        <a href="/staff/add" class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-1"></i> Register Staff
        </a>
    </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-3 p-3 bg-primary-subtle text-primary me-3 fs-4">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted fw-normal mb-1">Total Employees</h6>
                    <h3 class="fw-bold mb-0 text-dark"><%= stats.totalStaff %></h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-3 p-3 bg-success-subtle text-success me-3 fs-4">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted fw-normal mb-1">Active Staff</h6>
                    <h3 class="fw-bold mb-0 text-dark"><%= stats.activeStaff %></h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-3 p-3 bg-info-subtle text-info me-3 fs-4">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted fw-normal mb-1">Present Today</h6>
                    <h3 class="fw-bold mb-0 text-dark"><%= stats.todayPresent %></h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-3 p-3 bg-warning-subtle text-warning me-3 fs-4">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <h6 class="text-muted fw-normal mb-1">Pending Leaves</h6>
                    <h3 class="fw-bold mb-0 text-dark"><%= stats.pendingLeaves %></h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Role Distribution Row -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom pt-3 pb-2 px-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-diagram-3-fill me-2 text-primary"></i>Role-wise Staff Distribution</h6>
            </div>
            <div class="card-body p-3">
                <div class="d-flex flex-wrap gap-2">
                    <% if (typeof roleDistribution !== 'undefined' && roleDistribution.length > 0) { %>
                        <% roleDistribution.forEach(role => { %>
                            <div class="border rounded-3 p-2 px-3 d-flex flex-column justify-content-center align-items-center <%= role.staff_count === 0 ? 'bg-danger-subtle border-danger' : 'bg-light' %>" style="min-width: 130px;">
                                <span class="small fw-semibold text-muted mb-1 text-center"><%= role.role_name %></span>
                                <h4 class="fw-bold mb-0 <%= role.staff_count === 0 ? 'text-danger' : 'text-primary' %>"><%= role.staff_count %></h4>
                                <% if (role.staff_count === 0) { %>
                                    <span class="badge bg-danger mt-1" style="font-size: 0.7rem;"><i class="bi bi-exclamation-triangle-fill me-1"></i>Staff Needed</span>
                                <% } %>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="text-muted small">No role data configured.</div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-transparent border-0 pt-3 pb-0 px-4">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link <%= activeTab === 'directory' ? 'active fw-bold' : '' %>" href="/staff?tab=directory">
                    <i class="bi bi-person-lines-fill me-1"></i> Staff Directory
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= activeTab === 'attendance' ? 'active fw-bold' : '' %>" href="/staff?tab=attendance">
                    <i class="bi bi-clock-history me-1"></i> Today's Attendance
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= activeTab === 'leaves' ? 'active fw-bold' : '' %>" href="/staff?tab=leaves">
                    <i class="bi bi-calendar-event me-1"></i> Leave Applications
                    <% if (stats.pendingLeaves > 0) { %>
                        <span class="badge bg-danger ms-1"><%= stats.pendingLeaves %></span>
                    <% } %>
                </a>
            </li>
        </ul>
    </div>

    <div class="card-body p-4">
        <% if (activeTab === 'directory') { %>
            <!-- Filters -->
            <form action="/staff" method="GET" class="row g-3 mb-4">
                <input type="hidden" name="tab" value="directory">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Search by Code, Name, Email, Designation..." value="<%= search %>">
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <select name="department_id" class="form-select bg-light">
                        <option value="">-- All Departments --</option>
                        <% departments.forEach(d => { %>
                            <option value="<%= d.id %>" <%= departmentId == d.id ? 'selected' : '' %>><%= d.department_name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-2">
                    <select name="status" class="form-select bg-light">
                        <option value="">-- All Status --</option>
                        <option value="Full-Time" <%= status === 'Full-Time' ? 'selected' : '' %>>Full-Time</option>
                        <option value="Part-Time" <%= status === 'Part-Time' ? 'selected' : '' %>>Part-Time</option>
                        <option value="Contract" <%= status === 'Contract' ? 'selected' : '' %>>Contract</option>
                        <option value="On Leave" <%= status === 'On Leave' ? 'selected' : '' %>>On Leave</option>
                        <option value="Terminated" <%= status === 'Terminated' ? 'selected' : '' %>>Terminated</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                    <a href="/staff" class="btn btn-light border"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Employee Code</th>
                            <th>Full Name</th>
                            <th>Role & Designation</th>
                            <th>Department</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (staffMembers.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i> No staff members found matching criteria.
                                </td>
                            </tr>
                        <% } else { %>
                            <% staffMembers.forEach(s => { %>
                                <tr>
                                    <td><span class="badge bg-secondary-subtle text-dark border font-monospace"><%= s.employee_code %></span></td>
                                    <td class="fw-semibold"><%= s.first_name %> <%= s.last_name %></td>
                                    <td>
                                        <div class="fw-semibold text-dark"><%= s.designation %></div>
                                        <small class="text-muted"><%= s.role_name %></small>
                                    </td>
                                    <td><%= s.department_name || 'N/A' %></td>
                                    <td><%= s.phone || 'N/A' %></td>
                                    <td>
                                        <% if (s.is_active && s.employment_status !== 'Terminated') { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle"><%= s.employment_status %></span>
                                        <% } else { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/staff/view/<%= s.id %>" class="btn btn-outline-secondary" title="View Profile"><i class="bi bi-eye"></i></a>
                                            <a href="/staff/edit/<%= s.id %>" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>

        <% } else if (activeTab === 'attendance') { %>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Daily Attendance Log (<%= todayStr %>)</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#markAttendanceModal">
                    <i class="bi bi-plus-lg me-1"></i> Log Attendance
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Staff Code</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (attendanceList.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-clock-history fs-1 d-block mb-2 text-muted"></i> No attendance recorded for today.
                                </td>
                            </tr>
                        <% } else { %>
                            <% attendanceList.forEach(a => { %>
                                <tr>
                                    <td><span class="badge bg-light text-dark font-monospace border"><%= a.employee_code %></span></td>
                                    <td class="fw-semibold"><%= a.first_name %> <%= a.last_name %></td>
                                    <td><%= a.department_name || 'N/A' %></td>
                                    <td><%= a.check_in || '--:--' %></td>
                                    <td><%= a.check_out || '--:--' %></td>
                                    <td>
                                        <% if (a.status === 'Present') { %>
                                            <span class="badge bg-success">Present</span>
                                        <% } else if (a.status === 'Late') { %>
                                            <span class="badge bg-warning text-dark">Late</span>
                                        <% } else if (a.status === 'Half Day') { %>
                                            <span class="badge bg-info text-dark">Half Day</span>
                                        <% } else if (a.status === 'On Leave') { %>
                                            <span class="badge bg-secondary">On Leave</span>
                                        <% } else { %>
                                            <span class="badge bg-danger">Absent</span>
                                        <% } %>
                                    </td>
                                    <td><small class="text-muted"><%= a.remarks || '-' %></small></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>

        <% } else if (activeTab === 'leaves') { %>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Staff Leave Applications</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#applyLeaveModal">
                    <i class="bi bi-plus-lg me-1"></i> Apply Leave
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Staff Member</th>
                            <th>Type</th>
                            <th>Dates</th>
                            <th>Total Days</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (leaveRequests.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-calendar-check fs-1 d-block mb-2 text-muted"></i> No leave applications found.
                                </td>
                            </tr>
                        <% } else { %>
                            <% leaveRequests.forEach(l => { %>
                                <tr>
                                    <td>
                                        <div class="fw-semibold"><%= l.first_name %> <%= l.last_name %></div>
                                        <small class="text-muted"><%= l.employee_code %></small>
                                    </td>
                                    <td><span class="badge bg-light text-dark border"><%= l.leave_type %> Leave</span></td>
                                    <td><%= l.start_date %> to <%= l.end_date %></td>
                                    <td class="fw-bold"><%= l.total_days %> Day(s)</td>
                                    <td><small class="text-muted"><%= l.reason || '-' %></small></td>
                                    <td>
                                        <% if (l.status === 'Approved') { %>
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Approved</span>
                                        <% } else if (l.status === 'Rejected') { %>
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Rejected</span>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass me-1"></i> Pending</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <% if (l.status === 'Pending' && currentUser.role_name === 'Administrator') { %>
                                            <form action="/staff/leave/status" method="POST" class="d-inline-block">
                                                <input type="hidden" name="leave_id" value="<%= l.id %>">
                                                <button type="submit" name="status" value="Approved" class="btn btn-sm btn-outline-success me-1" title="Approve">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                                <button type="submit" name="status" value="Rejected" class="btn btn-sm btn-outline-danger" title="Reject">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <small class="text-muted"><%= l.approver_name ? 'By ' + l.approver_name : '-' %></small>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal 1: Mark Attendance -->
<div class="modal fade" id="markAttendanceModal" tabindex="-1" aria-labelledby="markAttendanceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form action="/staff/attendance/mark" method="POST">
                <div class="modal-header border-0 bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="markAttendanceModalLabel"><i class="bi bi-clock-history me-2"></i> Log Daily Attendance</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Staff Member *</label>
                        <select name="staff_id" class="form-select" required>
                            <option value="">-- Choose Employee --</option>
                            <% staffMembers.forEach(s => { %>
                                <option value="<%= s.id %>"><%= s.employee_code %> - <%= s.first_name %> <%= s.last_name %> (<%= s.designation %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Attendance Date *</label>
                        <input type="date" name="attendance_date" class="form-control" value="<%= todayStr %>" required>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Check In Time</label>
                            <input type="time" name="check_in" class="form-control" value="08:00">
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Check Out Time</label>
                            <input type="time" name="check_out" class="form-control" value="17:00">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Attendance Status *</label>
                        <select name="status" class="form-select" required>
                            <option value="Present" selected>Present</option>
                            <option value="Late">Late</option>
                            <option value="Half Day">Half Day</option>
                            <option value="On Leave">On Leave</option>
                            <option value="Absent">Absent</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-semibold">Remarks</label>
                        <input type="text" name="remarks" class="form-control" placeholder="Optional notes (e.g. Traffic delay)">
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Save Attendance</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Apply Leave -->
<div class="modal fade" id="applyLeaveModal" tabindex="-1" aria-labelledby="applyLeaveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form action="/staff/leave/apply" method="POST">
                <div class="modal-header border-0 bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="applyLeaveModalLabel"><i class="bi bi-calendar-plus me-2"></i> Apply Staff Leave</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Staff Member *</label>
                        <select name="staff_id" class="form-select" required>
                            <option value="">-- Choose Employee --</option>
                            <% staffMembers.forEach(s => { %>
                                <option value="<%= s.id %>"><%= s.employee_code %> - <%= s.first_name %> <%= s.last_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Leave Type *</label>
                        <select name="leave_type" class="form-select" required>
                            <option value="Casual" selected>Casual Leave</option>
                            <option value="Sick">Sick Leave</option>
                            <option value="Annual">Annual Leave</option>
                            <option value="Maternity">Maternity Leave</option>
                            <option value="Unpaid">Unpaid Leave</option>
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Start Date *</label>
                            <input type="date" name="start_date" class="form-control" value="<%= todayStr %>" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">End Date *</label>
                            <input type="date" name="end_date" class="form-control" value="<%= todayStr %>" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Total Days *</label>
                        <input type="number" name="total_days" class="form-control" value="1" min="1" max="60" required>
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-bold">Reason for Leave</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="State reason for leave request..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark"><i class="bi bi-send me-1"></i> Submit Leave Application</button>
                </div>
            </form>
        </div>
    </div>
</div>
