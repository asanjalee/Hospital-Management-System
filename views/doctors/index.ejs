<!-- Doctor Directory View -->
<div class="container-fluid px-0">

    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Header Banner & Action -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-person-badge-fill text-primary me-2"></i>Doctor Profiles & Departments
            </h3>
            <p class="text-muted mb-0">Manage hospital specialists, consultation fees, schedules, and department assignments</p>
        </div>
        <div>
            <a href="/doctors/add" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium">
                <i class="bi bi-person-plus-fill fs-5"></i>
                <span>Add New Doctor</span>
            </a>
        </div>
    </div>

    <!-- Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3 text-primary d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-person-badge fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Total Specialists</div>
                        <h4 class="fw-bold mb-0 text-dark"><%= stats.total %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success-subtle p-3 text-success d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-check-circle fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Currently Available</div>
                        <h4 class="fw-bold mb-0 text-success"><%= stats.available %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-12 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info bg-opacity-10 p-3 text-info d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-building fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Active Departments</div>
                        <h4 class="fw-bold mb-0 text-dark"><%= stats.departmentsCount %></h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters & Search Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <form action="/doctors" method="GET" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-start-0 ps-0" placeholder="Search by name, spec, room..." value="<%= search %>">
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <select name="department_id" class="form-select bg-light">
                        <option value="">All Departments</option>
                        <% departments.forEach(dept => { %>
                            <option value="<%= dept.id %>" <%= departmentId == dept.id ? 'selected' : '' %>>
                                <%= dept.department_name %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <select name="availability" class="form-select bg-light">
                        <option value="">All Availability</option>
                        <option value="1" <%= availability === '1' ? 'selected' : '' %>>Available Only</option>
                        <option value="0" <%= availability === '0' ? 'selected' : '' %>>Unavailable / On Leave</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-medium">Filter</button>
                    <a href="/doctors" class="btn btn-outline-secondary px-3" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Doctor Cards Grid -->
    <% if (doctors && doctors.length > 0) { %>
        <div class="row g-3">
            <% doctors.forEach(doc => { %>
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-3 h-100 bg-white hover-shadow transition-all">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle bg-primary bg-opacity-10 text-primary fw-bold rounded-circle d-flex align-items-center justify-content-center fs-4" style="width: 54px; height: 54px;">
                                        <%= doc.full_name ? doc.full_name.replace('Dr. ', '').charAt(0).toUpperCase() : 'D' %>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-1 text-dark"><%= doc.full_name %></h5>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill fw-semibold px-2 py-1 small">
                                            <%= doc.specialization %>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3 flex-grow-1">
                                <div class="d-flex align-items-center text-muted small mb-2">
                                    <i class="bi bi-building me-2 text-secondary"></i>
                                    <strong class="text-dark me-1">Department:</strong> <%= doc.department_name %>
                                </div>
                                <div class="d-flex align-items-center text-muted small mb-2">
                                    <i class="bi bi-door-open me-2 text-secondary"></i>
                                    <strong class="text-dark me-1">Location:</strong> <%= doc.room_number || 'Main Clinic' %>
                                </div>
                                <div class="d-flex align-items-center text-muted small mb-2">
                                    <i class="bi bi-cash-stack me-2 text-secondary"></i>
                                    <strong class="text-dark me-1">Fee:</strong> <span class="text-success fw-bold">Rs. <%= Number(doc.consultation_fee).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></span>
                                </div>
                                <% if (doc.availability_schedule) { %>
                                    <div class="d-flex align-items-center text-muted small mb-2">
                                        <i class="bi bi-clock me-2 text-secondary"></i>
                                        <span class="text-truncate"><%= doc.availability_schedule %></span>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Availability & Toggle -->
                            <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                                <div>
                                    <% if (doc.is_available === 1) { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-semibold">
                                            <i class="bi bi-check-circle-fill me-1"></i> Available
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1 fw-semibold">
                                            <i class="bi bi-dash-circle-fill me-1"></i> On Leave
                                        </span>
                                    <% } %>
                                </div>

                                <div class="d-flex align-items-center gap-1">
                                    <form action="/doctors/toggle-availability/<%= doc.id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-light border text-muted px-2" title="Toggle Availability Status">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                    </form>
                                    <a href="/doctors/view/<%= doc.id %>" class="btn btn-sm btn-outline-primary fw-medium px-3">
                                        View
                                    </a>
                                    <a href="/doctors/edit/<%= doc.id %>" class="btn btn-sm btn-light text-dark border fw-medium px-2" title="Edit Doctor Profile">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="card border-0 shadow-sm rounded-3 bg-white text-center py-5">
            <div class="card-body">
                <i class="bi bi-person-x display-4 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold text-dark mb-1">No Doctors Found</h5>
                <p class="text-muted mb-3">No specialist profile matching your search filters was found.</p>
                <a href="/doctors/add" class="btn btn-primary fw-medium px-4">Register New Doctor</a>
            </div>
        </div>
    <% } %>

</div>
