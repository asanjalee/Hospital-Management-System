<!-- Laboratory Management Directory View -->
<div class="container-fluid px-0">

    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Header Banner & Action -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-eyedropper text-primary me-2"></i>Laboratory Management & Diagnostic Testing
            </h3>
            <p class="text-muted mb-0">Track lab test requests, sample collection, status progression, and clinical results</p>
        </div>
        <div>
            <a href="/laboratory/request" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium">
                <i class="bi bi-plus-circle-fill fs-5"></i>
                <span>Order Lab Test</span>
            </a>
        </div>
    </div>

    <!-- Metric KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-clipboard2-pulse fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Total Orders</div>
                        <h4 class="fw-bold mb-0 text-dark"><%= stats.total %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning-emphasis p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-hourglass-split fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Pending Processing</div>
                        <h4 class="fw-bold mb-0 text-warning-emphasis"><%= stats.pending %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-gear-wide-connected fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">In Progress</div>
                        <h4 class="fw-bold mb-0 text-info"><%= stats.inProgress %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-check2-all fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Completed Results</div>
                        <h4 class="fw-bold mb-0 text-success"><%= stats.completed %></h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <form action="/laboratory" method="GET" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-start-0 ps-0" placeholder="Search lab #, test name, patient..." value="<%= search %>">
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <select name="status" class="form-select bg-light">
                        <option value="">All Statuses</option>
                        <option value="Pending" <%= status === 'Pending' ? 'selected' : '' %>>Pending</option>
                        <option value="In Progress" <%= status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                        <option value="Completed" <%= status === 'Completed' ? 'selected' : '' %>>Completed</option>
                        <option value="Cancelled" <%= status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <select name="category" class="form-select bg-light">
                        <option value="">All Categories</option>
                        <option value="Hematology" <%= category === 'Hematology' ? 'selected' : '' %>>Hematology</option>
                        <option value="Biochemistry" <%= category === 'Biochemistry' ? 'selected' : '' %>>Biochemistry</option>
                        <option value="Microbiology" <%= category === 'Microbiology' ? 'selected' : '' %>>Microbiology</option>
                        <option value="Radiology" <%= category === 'Radiology' ? 'selected' : '' %>>Radiology</option>
                        <option value="Pathology" <%= category === 'Pathology' ? 'selected' : '' %>>Pathology</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-medium">Filter</button>
                    <a href="/laboratory" class="btn btn-outline-secondary px-3" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Lab Requests Table -->
    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="card-body p-0">
            <% if (labRequests && labRequests.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Request #</th>
                                <th>Test Name & Category</th>
                                <th>Patient</th>
                                <th>Ordering Specialist</th>
                                <th>Requested Date</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% labRequests.forEach(lab => { %>
                                <tr>
                                    <td class="ps-3">
                                        <a href="/laboratory/view/<%= lab.id %>" class="fw-bold text-primary text-decoration-none">
                                            <%= lab.request_number %>
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= lab.test_name %></div>
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill small px-2 py-1"><%= lab.test_category || 'General Lab' %></span>
                                    </td>
                                    <td>
                                        <a href="/patients/view/<%= lab.patient_uid %>" class="text-dark fw-bold text-decoration-none">
                                            <%= lab.patient_first_name %> <%= lab.patient_last_name %>
                                        </a>
                                        <div class="small text-muted"><i class="bi bi-card-text me-1"></i><%= lab.patient_uid %></div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark"><%= lab.doctor_name || 'Hospital Clinical OPD' %></div>
                                        <div class="small text-muted"><%= lab.specialization || 'Attending Physician' %></div>
                                    </td>
                                    <td>
                                        <div class="small text-dark fw-semibold"><i class="bi bi-calendar3 me-1 text-primary"></i><%= lab.requested_date %></div>
                                    </td>
                                    <td>
                                        <% if (lab.status === 'Pending') { %>
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 fw-semibold">Pending</span>
                                        <% } else if (lab.status === 'In Progress') { %>
                                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1 fw-semibold">In Progress</span>
                                        <% } else if (lab.status === 'Completed') { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-semibold">Completed</span>
                                        <% } else { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-semibold">Cancelled</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end pe-3">
                                        <a href="/laboratory/view/<%= lab.id %>" class="btn btn-sm btn-outline-primary fw-medium">View Results</a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-eyedropper display-4 mb-3 text-secondary d-block"></i>
                    <h5 class="fw-bold text-dark mb-1">No Laboratory Requests Found</h5>
                    <p class="text-muted mb-3">No laboratory diagnostic orders match the current filter criteria.</p>
                    <a href="/laboratory/request" class="btn btn-primary fw-medium px-4">Order Lab Test</a>
                </div>
            <% } %>
        </div>
    </div>

</div>
