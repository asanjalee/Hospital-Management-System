<!-- View Lab Request & Enter Results View -->
<div class="container-fluid px-0">

    <!-- Flash Messages (Hidden during print) -->
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4 d-print-none" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4 d-print-none" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Header Navigation (Hidden during print) -->
    <div class="d-flex align-items-center justify-content-between mb-3 d-print-none flex-wrap gap-2">
        <div>
            <a href="/laboratory" class="text-decoration-none text-muted small fw-medium mb-1 d-inline-block">
                <i class="bi bi-arrow-left me-1"></i> Back to Laboratory Directory
            </a>
            <h3 class="fw-bold mb-0 text-dark">Diagnostic Test Request <%= lab.request_number %></h3>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="form-check form-switch bg-white border px-3 py-2 rounded-3 shadow-sm mb-0">
                <input class="form-check-input ms-0 me-2" type="checkbox" id="toggleSignatureLab" checked onchange="document.querySelectorAll('.signature-block').forEach(el => el.style.display = this.checked ? 'flex' : 'none')">
                <label class="form-check-label small fw-semibold text-dark" for="toggleSignatureLab">
                    <i class="bi bi-pen me-1 text-primary"></i> Include Signature Lines
                </label>
            </div>
            <button onclick="window.print()" class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm rounded-3">
                <i class="bi bi-printer-fill me-1"></i> Print Official Lab Report
            </button>
        </div>
    </div>

    <!-- Official Printable Lab Report Container -->
    <div class="card border-0 shadow-sm rounded-3 bg-white mb-4 p-3 p-md-4 d-flex flex-column justify-content-between printable-page-container" id="printableLabReport">

        <div>
            <!-- Printable Hospital & Lab Header -->
            <div class="row align-items-center mb-3 pb-3 border-bottom printable-header">
                <div class="col-7">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-primary text-white p-2 p-md-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-hospital fs-3"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold text-dark mb-0">ST. GEORGE DIAGNOSTIC LABORATORY</h4>
                            <p class="text-muted small mb-0">Department of Clinical Pathology & Diagnostics</p>
                            <p class="text-muted small mb-0">124 Healthcare Boulevard, Colombo 03 | Tel: +94 11 2345679</p>
                        </div>
                    </div>
                </div>
                <div class="col-5 text-end">
                    <h3 class="fw-bold text-primary mb-0">LABORATORY REPORT</h3>
                    <div class="fs-6 fw-bold text-dark font-monospace"><%= lab.request_number %></div>
                    <div class="text-muted small">Requested: <strong><%= lab.requested_date %></strong></div>
                    <% if (lab.completed_date) { %>
                        <div class="text-muted small">Completed: <strong><%= lab.completed_date %></strong></div>
                    <% } %>
                    <div class="mt-1">
                        <% if (lab.status === 'Completed') { %>
                            <span class="badge bg-success px-2 py-1 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> COMPLETED</span>
                        <% } else if (lab.status === 'In Progress') { %>
                            <span class="badge bg-info text-dark px-2 py-1 rounded-pill"><i class="bi bi-gear-wide-connected me-1"></i> IN ANALYSIS</span>
                        <% } else if (lab.status === 'Pending') { %>
                            <span class="badge bg-warning text-dark px-2 py-1 rounded-pill"><i class="bi bi-hourglass-split me-1"></i> PENDING SAMPLE</span>
                        <% } else { %>
                            <span class="badge bg-danger px-2 py-1 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i> CANCELLED</span>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Patient & Ordering Doctor Details -->
            <div class="row g-3 mb-3 p-3 bg-light rounded-3 printable-context">
                <div class="col-6">
                    <div class="small text-muted mb-1 text-uppercase fw-semibold">Patient Information:</div>
                    <h6 class="fw-bold text-dark mb-0"><%= lab.patient_first_name %> <%= lab.patient_last_name %></h6>
                    <div class="small text-dark"><strong>Patient UID:</strong> <%= lab.patient_uid %></div>
                    <div class="small text-muted">Gender: <%= lab.patient_gender %> &bull; Phone: <%= lab.patient_phone || 'N/A' %></div>
                </div>
                <div class="col-6 text-end">
                    <div class="small text-muted mb-1 text-uppercase fw-semibold">Ordering Medical Officer:</div>
                    <div class="fw-bold text-dark small"><%= lab.doctor_name || 'Hospital Clinical OPD' %></div>
                    <div class="small text-muted">Specialization: <%= lab.specialization %> (<%= lab.department_name %>)</div>
                    <div class="small text-muted">Test Category: <strong><%= lab.test_category || 'General Diagnostic' %></strong></div>
                </div>
            </div>

            <!-- Diagnostic Test Information -->
            <div class="mb-3">
                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-eyedropper text-primary me-2"></i>Ordered Test Panel: <%= lab.test_name %></h6>
                <% if (lab.remarks) { %>
                    <div class="p-2 bg-light rounded-3 text-dark small">
                        <strong>Clinical Instructions / Sampling Remarks:</strong> <%= lab.remarks %>
                    </div>
                <% } %>
            </div>

            <!-- Diagnostic Results & Findings Section -->
            <div class="mb-3">
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-journal-check text-success me-2"></i>Diagnostic Results & Observations</h6>
                
                <% if (lab.result_summary && lab.result_summary.trim()) { %>
                    <div class="p-3 bg-white border rounded-3 font-monospace text-dark mb-2">
                        <pre class="mb-0" style="font-family: inherit; font-size: 13px; white-space: pre-wrap;"><%= lab.result_summary %></pre>
                    </div>
                <% } else { %>
                    <div class="p-3 bg-light border rounded-3 text-muted text-center italic small">
                        <i class="bi bi-hourglass me-2"></i>Lab test results have not been logged yet or sample processing is in progress.
                    </div>
                <% } %>
            </div>

            <% if (lab.status === 'Completed') { %>
                <!-- Interactive Form Locked State -->
                <div class="alert alert-secondary d-flex align-items-center mb-3 border shadow-sm d-print-none">
                    <i class="bi bi-lock-fill text-secondary fs-4 me-3"></i>
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">Data Locked & Finalized</h6>
                        <p class="mb-0 small text-muted">Completed clinical diagnostic reports are permanently locked to preserve data integrity. Please contact the Hospital IT Administrator to raise a formal amendment request if emergency modifications are required.</p>
                    </div>
                </div>
            <% } else { %>
                <!-- Interactive Result Entry & Status Update Form (Hidden during print) -->
                <div class="card border border-primary bg-light shadow-sm rounded-3 mb-3 d-print-none">
                    <div class="card-header bg-primary text-white p-2 px-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i>Update Lab Test Results & Workflow</h6>
                    </div>
                    <div class="card-body p-3 bg-white">
                        <form action="/laboratory/status/<%= lab.id %>" method="POST">
                            <div class="mb-2">
                                <label for="status" class="form-label fw-semibold text-dark small mb-1">Lab Order Status</label>
                                <select id="status" name="status" class="form-select">
                                    <option value="Pending" <%= lab.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="In Progress" <%= lab.status === 'In Progress' ? 'selected' : '' %>>In Progress (Testing in Lab)</option>
                                    <option value="Completed" <%= lab.status === 'Completed' ? 'selected' : '' %>>Completed (Results Ready)</option>
                                    <option value="Cancelled" <%= lab.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                            </div>

                            <div class="mb-2">
                                <label for="result_summary" class="form-label fw-semibold text-dark small mb-1">Laboratory Result Findings / Data</label>
                                <textarea id="result_summary" name="result_summary" rows="4" class="form-control font-monospace" placeholder="Enter test parameters, reference ranges, and observations...&#10;e.g. Hemoglobin: 13.5 g/dL (Normal: 12.0 - 16.0)&#10;Fasting Blood Sugar: 105 mg/dL"><%= lab.result_summary || '' %></textarea>
                                <div class="form-text small">Include key parameters, reference ranges, and lab unit metrics.</div>
                            </div>

                            <div class="mb-3">
                                <label for="remarks" class="form-label fw-semibold text-dark small mb-1">Technician / Pathologist Remarks</label>
                                <textarea id="remarks" name="remarks" rows="2" class="form-control" placeholder="Additional lab notes or recommendation for re-testing..."><%= lab.remarks || '' %></textarea>
                            </div>

                            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                                <button type="submit" class="btn btn-success fw-medium">
                                    <i class="bi bi-check-circle-fill me-1"></i> Save Lab Results & Update Status
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            <% } %>

            <!-- Signature Section (Spaced Flex Layout) -->
            <div class="signature-block my-4 pt-3">
                <div class="signature-item">
                    <div class="signature-line">
                        <div class="small fw-bold text-dark">Medical Laboratory Technologist</div>
                    </div>
                </div>
                <div class="signature-item">
                    <div class="signature-line">
                        <div class="small fw-bold text-dark">Consultant Pathologist Signature</div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Strict Bottom Footer Watermark Notice -->
        <div class="printable-footer pt-2 border-top text-center text-muted small mt-auto">
            <i class="bi bi-shield-check text-success me-1"></i> System Verified Digital Report &bull; Generated by St. George Diagnostic System &bull; Valid Without Physical Signature
        </div>

    </div>

</div>
