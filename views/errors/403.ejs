<div class="error-page">
    <div class="error-content text-center">
        <div class="error-icon">
            <i class="bi bi-shield-exclamation"></i>
        </div>
        <h1>403</h1>
        <h3>Access Denied</h3>
        <p class="text-muted"><%= typeof message !== 'undefined' ? message : 'You do not have permission to access this page.' %></p>

        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="alert alert-warning mt-3 d-inline-block text-start" style="max-width:480px;">
            <strong><i class="bi bi-person-badge me-1"></i>Your Role:</strong>
            <span class="badge bg-secondary ms-1"><%= currentUser.role_name %></span>
            <% if (typeof requiredRoles !== 'undefined' && requiredRoles && requiredRoles.length > 0) { %>
            <hr class="my-2">
            <strong><i class="bi bi-key me-1"></i>Required Role(s):</strong>
            <div class="mt-1">
                <% requiredRoles.forEach(function(r){ %>
                    <span class="badge bg-primary me-1"><%= r %></span>
                <% }); %>
            </div>
            <% } %>
        </div>
        <% } %>

        <div class="mt-3">
            <a href="/dashboard" class="btn btn-primary me-2">
                <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Go Back
            </a>
        </div>
    </div>
</div>
