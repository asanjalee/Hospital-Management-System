<!-- Book Appointment Form View -->
<div class="container-fluid px-0">

    <!-- Header Navigation -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <a href="/appointments" class="text-decoration-none text-muted small fw-medium mb-1 d-inline-block">
                <i class="bi bi-arrow-left me-1"></i> Back to Appointments
            </a>
            <h3 class="fw-bold mb-0 text-dark">Book New Consultation Appointment</h3>
        </div>
        <div>
            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill shadow-sm">
                <i class="bi bi-ticket-perforated me-1"></i> <%= autoNumber %>
            </span>
        </div>
    </div>

    <!-- Error Alert Banner -->
    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
            <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Booking Error:</h6>
            <ul class="mb-0 ps-3">
                <% errors.forEach(err => { %>
                    <li><%= err.msg %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <form action="/appointments/book" method="POST">
        <input type="hidden" name="appointment_number" value="<%= autoNumber %>">

        <div class="row g-4">
            <!-- Left Column: Patient & Doctor Selection -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                    <div class="card-header bg-white border-bottom p-3">
                        <h5 class="fw-bold mb-0 text-dark d-flex align-items-center">
                            <i class="bi bi-people text-primary me-2 fs-5"></i>Patient & Specialist Selection
                        </h5>
                    </div>
                    <div class="card-body p-4">

                        <!-- Patient Dropdown -->
                        <div class="mb-4">
                            <label for="patient_id" class="form-label fw-semibold text-dark">Select Registered Patient <span class="text-danger">*</span></label>
                            <select id="patient_id" name="patient_id" class="form-select form-select-lg" required>
                                <option value="">-- Choose Patient --</option>
                                <% patients.forEach(p => { %>
                                    <option value="<%= p.id %>" <%= (formData.patient_id == p.id || prePatientId == p.id) ? 'selected' : '' %>>
                                        <%= p.patient_uid %> — <%= p.first_name %> <%= p.last_name %> (<%= p.phone || 'No Phone' %>)
                                    </option>
                                <% }); %>
                            </select>
                            <div class="form-text">Don't see the patient? <a href="/patients/add" target="_blank" class="text-primary fw-medium">Register a new patient first</a>.</div>
                        </div>

                        <!-- Doctor Dropdown -->
                        <div class="mb-4">
                            <label for="doctor_id" class="form-label fw-semibold text-dark">Select Specialist Doctor <span class="text-danger">*</span></label>
                            <select id="doctor_id" name="doctor_id" class="form-select form-select-lg" required>
                                <option value="">-- Choose Specialist Doctor --</option>
                                <% doctors.forEach(doc => { %>
                                    <option value="<%= doc.id %>" <%= (formData.doctor_id == doc.id || preDoctorId == doc.id) ? 'selected' : '' %>>
                                        <%= doc.full_name %> &bull; <%= doc.specialization %> (<%= doc.department_name %> - Rs. <%= Number(doc.consultation_fee).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>)
                                    </option>
                                <% }); %>
                            </select>
                            <div class="form-text">Only available doctors with active schedules are displayed.</div>
                        </div>

                        <!-- Reason for Visit -->
                        <div class="mb-3">
                            <label for="reason" class="form-label fw-semibold text-dark">Reason for Visit / Main Complaints</label>
                            <textarea id="reason" name="reason" rows="3" class="form-control" placeholder="e.g. Routine blood pressure review, persistent migraine, follow-up checkup..."><%= formData.reason || '' %></textarea>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Right Column: Date & Slot Selection -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                    <div class="card-header bg-white border-bottom p-3">
                        <h5 class="fw-bold mb-0 text-dark d-flex align-items-center">
                            <i class="bi bi-clock-history text-primary me-2 fs-5"></i>Date & Time Slot Selection
                        </h5>
                    </div>
                    <div class="card-body p-4">

                        <!-- Appointment Date Picker -->
                        <div class="mb-4">
                            <label for="appointment_date" class="form-label fw-semibold text-dark">Appointment Date <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-calendar-event"></i></span>
                                <input type="date" id="appointment_date" name="appointment_date" class="form-control" value="<%= formData.appointment_date || preDate %>" required>
                            </div>
                        </div>

                        <!-- Time Slot Selection Grid -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark mb-2">Select Time Slot <span class="text-danger">*</span></label>
                            <% 
                                const timeSlots = ['08:30 AM', '09:00 AM', '09:30 AM', '10:00 AM', '10:30 AM', '11:00 AM', '11:30 AM', '02:00 PM', '02:30 PM', '03:00 PM', '03:30 PM', '04:00 PM'];
                                const selectedTime = formData.appointment_time || preTime;
                            %>
                            <div class="row g-2">
                                <% timeSlots.forEach((slot, idx) => { %>
                                    <div class="col-6 col-sm-4">
                                        <input type="radio" class="btn-check" name="appointment_time" id="slot_<%= idx %>" value="<%= slot %>" <%= selectedTime === slot ? 'checked' : '' %> required>
                                        <label class="btn btn-outline-primary w-100 py-2 fw-medium text-nowrap rounded-3 text-center" for="slot_<%= idx %>">
                                            <i class="bi bi-clock me-1"></i> <%= slot %>
                                        </label>
                                    </div>
                                <% }); %>
                            </div>
                        </div>

                        <!-- Additional Notes -->
                        <div class="mb-4">
                            <label for="notes" class="form-label fw-semibold text-dark">Additional Administrative Notes</label>
                            <input type="text" id="notes" name="notes" class="form-control" placeholder="Optional notes for receptionist or medical staff..." value="<%= formData.notes || '' %>">
                        </div>

                        <!-- Submission Buttons -->
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a href="/appointments" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 fw-medium">
                                <i class="bi bi-calendar-check-fill me-1"></i> Confirm Appointment
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </form>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const doctorsData = <%- JSON.stringify(doctors.map(d => ({ id: d.id, full_name: d.full_name, schedule: d.availability_schedule }))) %>;
        // Import all upcoming active bookings
        const bookedSlots = <%- typeof scheduledAppts !== 'undefined' ? JSON.stringify(scheduledAppts.map(a => ({ doc_id: a.doctor_id, date_str: a.date_str, time: a.appointment_time }))) : '[]' %>;

        const doctorSelect = document.getElementById('doctor_id');
        const dateInput = document.getElementById('appointment_date');
        const timeGrid = document.querySelector('.row.g-2');
        const timeInputs = document.querySelectorAll('input.btn-check[name="appointment_time"]');

        function parseTimeStr(tStr) {
            const parts = tStr.trim().split(' ');
            if (parts.length < 2) return 0;
            const timeParts = parts[0].split(':');
            let h = parseInt(timeParts[0], 10);
            const m = parseInt(timeParts[1], 10);
            if (parts[1].toUpperCase() === 'PM' && h < 12) h += 12;
            if (parts[1].toUpperCase() === 'AM' && h === 12) h = 0;
            return h + (m / 60);
        }

        function updateScheduleUI() {
            const docId = doctorSelect.value;
            const dateStr = dateInput.value;
            
            // Un-disable everything first & flush visual locks
            timeInputs.forEach(input => { 
                input.disabled = false; 
                input.parentElement.style.opacity = '1'; 
                
                // Clear any "Booked" text overrides
                const label = input.nextElementSibling;
                if(label.getAttribute('data-original-text')) {
                    label.innerHTML = label.getAttribute('data-original-text');
                } else {
                    label.setAttribute('data-original-text', label.innerHTML);
                }
            });
            
            let oldWarning = document.getElementById('schedule-warning');
            if (oldWarning) oldWarning.remove();

            if (!docId || !dateStr) return;

            const targetDoc = doctorsData.find(d => d.id == docId);
            if (!targetDoc || !targetDoc.schedule) return;

            const schedLower = targetDoc.schedule.toLowerCase();
            const selectedDate = new Date(dateStr);
            const dayNames = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
            const dayStr = dayNames[selectedDate.getDay()];

            let worksToday = false;
            if (schedLower.includes('everyday') || schedLower.includes('daily')) worksToday = true;
            else if ((schedLower.includes('mon - fri') || schedLower.includes('mon-fri') || schedLower.includes('weekdays')) && ['mon','tue','wed','thu','fri'].includes(dayStr)) worksToday = true;
            else if (schedLower.includes(dayStr)) worksToday = true;

            if (!worksToday) {
                timeInputs.forEach(input => { 
                    input.checked = false;
                    input.disabled = true; 
                    input.parentElement.style.opacity = '0.4';
                });
                
                const warningDiv = document.createElement('div');
                warningDiv.id = 'schedule-warning';
                warningDiv.className = 'alert alert-warning py-2 mt-2 mb-3 small fw-bold shadow-sm';
                warningDiv.innerHTML = `<i class="bi bi-calendar-x-fill me-1"></i> Unavailable: ${targetDoc.full_name} does not work on this day. <br><span class="fw-normal">Official Schedule: ${targetDoc.schedule}</span>`;
                timeGrid.parentElement.insertBefore(warningDiv, timeGrid);
                return;
            }

            const timeMatch = targetDoc.schedule.match(/\((.*?)-(.*?)\)/);
            if (timeMatch) {
                const startNum = parseTimeStr(timeMatch[1]);
                const endNum = parseTimeStr(timeMatch[2]);
                
                if (startNum > 0 && endNum > 0) {
                    timeInputs.forEach(input => {
                        const slotNum = parseTimeStr(input.value);
                        if (slotNum < startNum || slotNum > endNum) {
                            input.checked = false;
                            input.disabled = true;
                            input.parentElement.style.opacity = '0.4';
                        }
                    });
                }
            }

            // Detect already-booked double-booking slots natively from DB snapshot
            const matchingBookings = bookedSlots.filter(b => b.doc_id == docId && b.date_str === dateStr);
            matchingBookings.forEach(booking => {
                timeInputs.forEach(input => {
                    if (input.value === booking.time) {
                        input.checked = false;
                        input.disabled = true;
                        input.parentElement.style.opacity = '0.3';
                        const label = input.nextElementSibling;
                        label.classList.remove('btn-outline-primary');
                        label.classList.add('btn-light', 'text-muted', 'border');
                        label.innerHTML = `<i class="bi bi-x-circle me-1 text-danger"></i> Booked`;
                    }
                });
            });
        }

        doctorSelect.addEventListener('change', updateScheduleUI);
        dateInput.addEventListener('change', updateScheduleUI);
        updateScheduleUI();
    });
</script>
