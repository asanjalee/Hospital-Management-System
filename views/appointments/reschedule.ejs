<!-- Reschedule Appointment View -->
<div class="container-fluid px-0">

    <!-- Header Navigation -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <a href="/appointments/view/<%= appointment.id %>" class="text-decoration-none text-muted small fw-medium mb-1 d-inline-block">
                <i class="bi bi-arrow-left me-1"></i> Back to Appointment Details
            </a>
            <h3 class="fw-bold mb-0 text-dark">Reschedule Appointment <%= appointment.appointment_number %></h3>
        </div>
        <div>
            <span class="badge bg-warning-subtle text-warning-emphasis fs-6 px-3 py-2 rounded-pill shadow-sm border border-warning-subtle">
                <i class="bi bi-clock-history me-1"></i> Rescheduling Mode
            </span>
        </div>
    </div>

    <!-- Error Alert Banner -->
    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
            <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Reschedule Error:</h6>
            <ul class="mb-0 ps-3">
                <% errors.forEach(err => { %>
                    <li><%= err.msg %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <form action="/appointments/reschedule/<%= appointment.id %>" method="POST">
        <div class="row g-4">
            <!-- Left Column: Patient & Current Status -->
            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                    <div class="card-header bg-white border-bottom p-3">
                        <h5 class="fw-bold mb-0 text-dark">Current Booking Info</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="text-muted small">Patient Name:</label>
                            <h5 class="fw-bold text-dark mb-0"><%= appointment.patient_first_name %> <%= appointment.patient_last_name %></h5>
                            <span class="text-primary small fw-semibold"><%= appointment.patient_uid %></span>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Current Doctor:</label>
                            <div class="fw-semibold text-dark"><%= appointment.doctor_name %></div>
                            <div class="small text-muted"><%= appointment.specialization %> &bull; <%= appointment.department_name %></div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Current Scheduled Date & Time:</label>
                            <div class="fw-bold text-danger"><%= appointment.appointment_date %> at <%= appointment.appointment_time %></div>
                        </div>
                        <div class="p-3 bg-light rounded-3 text-muted small">
                            <i class="bi bi-info-circle me-1 text-primary"></i> Rescheduling will update the appointment date/time and maintain all patient logs.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: New Date & Time Slot Form -->
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                    <div class="card-header bg-white border-bottom p-3">
                        <h5 class="fw-bold mb-0 text-dark">Select New Date & Slot</h5>
                    </div>
                    <div class="card-body p-4">

                        <!-- Select Specialist Doctor -->
                        <div class="mb-4">
                            <label for="doctor_id" class="form-label fw-semibold text-dark">Assigned Specialist <span class="text-danger">*</span></label>
                            <select id="doctor_id" name="doctor_id" class="form-select" required>
                                <% doctors.forEach(doc => { %>
                                    <option value="<%= doc.id %>" <%= appointment.doctor_id == doc.id ? 'selected' : '' %>>
                                        <%= doc.full_name %> &bull; <%= doc.specialization %> (<%= doc.department_name %>)
                                    </option>
                                <% }); %>
                            </select>
                        </div>

                        <!-- Select New Date -->
                        <div class="mb-4">
                            <label for="appointment_date" class="form-label fw-semibold text-dark">New Appointment Date <span class="text-danger">*</span></label>
                            <input type="date" id="appointment_date" name="appointment_date" class="form-control" value="<%= appointment.appointment_date %>" min="<%= typeof todayDate !== 'undefined' ? todayDate : '' %>" required>
                        </div>

                        <!-- Select New Time Slot -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark mb-2">New Time Slot <span class="text-danger">*</span></label>
                            <% 
                                const timeSlots = [];
                                for(let h=8; h<=20; h++) {
                                    let hStr = h > 12 ? h - 12 : (h === 0 ? 12 : h);
                                    hStr = hStr.toString().padStart(2, '0');
                                    let ampm = h < 12 ? 'AM' : 'PM';
                                    timeSlots.push(`${hStr}:00 ${ampm}`);
                                    if(h !== 20) timeSlots.push(`${hStr}:30 ${ampm}`);
                                }
                            %>
                            <div class="row g-2">
                                <% timeSlots.forEach((slot, idx) => { %>
                                    <div class="col-6 col-sm-4">
                                        <input type="radio" class="btn-check" name="appointment_time" id="rslot_<%= idx %>" value="<%= slot %>" <%= appointment.appointment_time === slot ? 'checked' : '' %> required>
                                        <label class="btn btn-outline-primary w-100 py-2 fw-medium text-nowrap rounded-3 text-center" for="rslot_<%= idx %>">
                                            <i class="bi bi-clock me-1"></i> <%= slot %>
                                        </label>
                                    </div>
                                <% }); %>
                            </div>
                        </div>

                        <!-- Reason for Reschedule -->
                        <div class="mb-4">
                            <label for="reason" class="form-label fw-semibold text-dark">Reason / Notes for Rescheduling</label>
                            <input type="text" id="reason" name="reason" class="form-control" placeholder="e.g. Patient requested schedule change..." value="<%= appointment.reason || '' %>">
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a href="/appointments/view/<%= appointment.id %>" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 fw-medium">
                                <i class="bi bi-check-circle-fill me-1"></i> Confirm Reschedule
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Using explicit parsing from native arrays for frontend security locks
        const doctorsData = <%- JSON.stringify(typeof doctors !== 'undefined' ? doctors.map(d => ({ id: d.id, full_name: d.full_name, schedule: d.availability_schedule })) : []) %>;
        const bookedSlots = <%- typeof scheduledAppts !== 'undefined' ? JSON.stringify(scheduledAppts.map(a => ({ doc_id: a.doctor_id, date_str: a.date_str, time: a.appointment_time }))) : '[]' %>;
        const currentAptId = "<%= appointment.id %>"; // Do not lock out the appointment's own current designated time if already selected.

        const doctorSelect = document.getElementById('doctor_id');
        const dateInput = document.getElementById('appointment_date');
        const timeGrid = document.querySelector('.row.g-2');
        const timeInputs = document.querySelectorAll('input.btn-check[name="appointment_time"]');

        function parseTimeStr(tStr) {
            const parts = tStr.trim().split(' ');
            if (parts.length < 2) return 0;
            const timeParts = parts[0].split(':');
            let h = parseInt(timeParts[0], 10);
            const m = parseInt(timeParts[1], 10);
            if (parts[1].toUpperCase() === 'PM' && h < 12) h += 12;
            if (parts[1].toUpperCase() === 'AM' && h === 12) h = 0;
            return h + (m / 60);
        }

        function updateScheduleUI() {
            const docId = doctorSelect.value;
            const dateStr = dateInput.value;
            
            // Un-disable everything first & flush visual locks
            timeInputs.forEach(input => { 
                input.disabled = false; 
                input.parentElement.style.opacity = '1'; 
                input.parentElement.style.display = 'block';
                
                // Clear any CSS overrides
                const label = input.nextElementSibling;
                label.classList.remove('btn-light', 'text-muted', 'border');
                label.classList.add('btn-outline-primary');
                
                // Clear text overrides
                if(label.getAttribute('data-original-text')) {
                    label.innerHTML = label.getAttribute('data-original-text');
                } else {
                    label.setAttribute('data-original-text', label.innerHTML);
                }
            });
            
            let oldWarning = document.getElementById('schedule-warning');
            if (oldWarning) oldWarning.remove();

            if (!docId || !dateStr) return;

            const targetDoc = doctorsData.find(d => d.id == docId);
            if (!targetDoc || !targetDoc.schedule) return;

            const schedLower = targetDoc.schedule.toLowerCase();
            const selectedDate = new Date(dateStr);
            const dayNames = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
            const dayStr = dayNames[selectedDate.getDay()];

            let worksToday = false;
            if (schedLower.includes('everyday') || schedLower.includes('daily')) worksToday = true;
            else if ((schedLower.includes('mon - fri') || schedLower.includes('mon-fri') || schedLower.includes('weekdays')) && ['mon','tue','wed','thu','fri'].includes(dayStr)) worksToday = true;
            else if (schedLower.includes(dayStr)) worksToday = true;

            if (!worksToday) {
                timeInputs.forEach(input => { 
                    input.checked = false;
                    input.disabled = true; 
                    input.parentElement.style.display = 'none';
                });
                
                const warningDiv = document.createElement('div');
                warningDiv.id = 'schedule-warning';
                warningDiv.className = 'alert alert-warning py-2 mt-2 mb-3 small fw-bold shadow-sm';
                warningDiv.innerHTML = `<i class="bi bi-calendar-x-fill me-1"></i> Unavailable: ${targetDoc.full_name} does not work on this day. <br><span class="fw-normal">Official Schedule: ${targetDoc.schedule}</span>`;
                timeGrid.parentElement.insertBefore(warningDiv, timeGrid);
                return;
            }

            const timeMatch = targetDoc.schedule.match(/\((.*?)-(.*?)\)/);
            if (timeMatch) {
                const startNum = parseTimeStr(timeMatch[1]);
                const endNum = parseTimeStr(timeMatch[2]);
                
                if (startNum > 0 && endNum > 0) {
                    timeInputs.forEach(input => {
                        const slotNum = parseTimeStr(input.value);
                        if (slotNum < startNum || slotNum >= endNum) {
                            input.checked = false;
                            input.disabled = true;
                            input.parentElement.style.display = 'none';
                        }
                    });
                }
            }

            // Detect past time slots for TODAY
            const staticToday = '<%= typeof todayDate !== "undefined" ? todayDate : "" %>';
            if (dateStr === staticToday) {
                const now = new Date();
                const currentH = now.getHours() + (now.getMinutes() / 60);
                timeInputs.forEach(input => {
                    const slotNum = parseTimeStr(input.value);
                    if (slotNum <= currentH) {
                        input.checked = false;
                        input.disabled = true;
                        input.parentElement.style.opacity = '0.3';
                        const label = input.nextElementSibling;
                        label.classList.remove('btn-outline-primary');
                        label.classList.add('btn-light', 'text-muted', 'border');
                        label.innerHTML = `<i class="bi bi-clock-history me-1 text-secondary"></i> Elapsed`;
                    }
                });
            }

            // Detect already-booked slots natively from DB snapshot (ignoring self-bookings)
            const matchingBookings = bookedSlots.filter(b => b.doc_id == docId && b.date_str === dateStr && b.id !== currentAptId); 
            // Note: Since scheduledAppts doesn't return `id` natively, we safely filter out our own booking based on DB status on the backend.
            // On frontend, if it's the current identical appointment_time natively, we can just not block our own slot.
            
            matchingBookings.forEach(booking => {
                timeInputs.forEach(input => {
                    if (input.value === booking.time) {
                        // EXCEPTION: Validate it is not literally the exact same original current appointment
                        const currentAptTime = "<%= appointment.appointment_time %>";
                        const currentAptDate = "<%= appointment.appointment_date %>";
                        if (booking.time === currentAptTime && booking.date_str === currentAptDate && booking.doc_id == "<%= appointment.doctor_id %>") {
                            return; // Retain ownership of own active appointment slot
                        }
                        
                        input.checked = false;
                        input.disabled = true;
                        input.parentElement.style.opacity = '0.3';
                        const label = input.nextElementSibling;
                        label.classList.remove('btn-outline-primary');
                        label.classList.add('btn-light', 'text-muted', 'border');
                        label.innerHTML = `<i class="bi bi-x-circle me-1 text-danger"></i> Booked`;
                    }
                });
            });
        }

        doctorSelect.addEventListener('change', updateScheduleUI);
        dateInput.addEventListener('change', updateScheduleUI);
        updateScheduleUI();
    });
</script>
