<!-- Appointment View & Details Screen -->
<div class="container-fluid px-0">

    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Header Navigation -->
    <div class="mb-3">
        <a href="/appointments" class="text-decoration-none text-muted small fw-medium">
            <i class="bi bi-arrow-left me-1"></i> Back to Appointments Directory
        </a>
    </div>

    <!-- Appointment Header Banner -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h3 class="fw-bold mb-0 text-dark">Appointment <%= appointment.appointment_number %></h3>
                        <% if (appointment.status === 'Scheduled') { %>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-semibold fs-6">Scheduled</span>
                        <% } else if (appointment.status === 'Completed') { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-semibold fs-6">Completed</span>
                        <% } else if (appointment.status === 'Cancelled') { %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-semibold fs-6">Cancelled</span>
                        <% } else { %>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 fw-semibold fs-6"><%= appointment.status %></span>
                        <% } %>
                    </div>
                    <p class="text-muted mb-0">
                        Scheduled for <strong><%= appointment.appointment_date %></strong> at <strong><%= appointment.appointment_time %></strong>
                    </p>
                </div>

                <!-- Action Controls -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <% if (appointment.status === 'Scheduled') { %>
                        <form action="/appointments/status/<%= appointment.id %>" method="POST" class="d-inline">
                            <input type="hidden" name="status" value="Completed">
                            <button type="submit" class="btn btn-success d-inline-flex align-items-center gap-2 rounded-3 px-3 py-2 fw-medium shadow-sm" <%= (typeof isCompletable === 'undefined' || !isCompletable) ? 'disabled title="Locked: Consultation shift has not actively started yet."' : '' %>>
                                <i class="bi bi-check-circle-fill"></i> Mark Completed
                            </button>
                        </form>
                        <a href="/appointments/reschedule/<%= appointment.id %>" class="btn btn-outline-primary d-inline-flex align-items-center gap-1 rounded-3 px-3 py-2 fw-medium">
                            <i class="bi bi-clock-history"></i> Reschedule
                        </a>
                        <form action="/appointments/status/<%= appointment.id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this appointment?')">
                            <input type="hidden" name="status" value="Cancelled">
                            <button type="submit" class="btn btn-outline-danger rounded-3 px-3 py-2 fw-medium">
                                <i class="bi bi-x-circle"></i> Cancel
                            </button>
                        </form>
                    <% } else { %>
                        <a href="/appointments/book?patient_id=<%= appointment.patient_pk %>" class="btn btn-primary d-inline-flex align-items-center gap-2 rounded-3 px-3 py-2 fw-medium shadow-sm">
                            <i class="bi bi-calendar-plus"></i> Book Follow-Up
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Cards Grid -->
    <div class="row g-4 mb-4">
        <!-- Patient Information Card -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-person-fill text-primary me-2"></i>Patient Details
                    </h6>
                    <a href="/patients/view/<%= appointment.patient_uid %>" class="btn btn-sm btn-link text-primary fw-semibold p-0">View Profile</a>
                </div>
                <div class="card-body p-3">
                    <h5 class="fw-bold text-dark mb-1"><%= appointment.patient_first_name %> <%= appointment.patient_last_name %></h5>
                    <p class="text-primary fw-medium mb-3">
                        <i class="bi bi-card-text me-1"></i><%= appointment.patient_uid %>
                    </p>
                    <hr class="my-2 opacity-25">
                    <div class="row g-2 small text-muted">
                        <div class="col-6"><strong>Phone:</strong> <%= appointment.patient_phone || 'N/A' %></div>
                        <div class="col-6"><strong>Gender:</strong> <%= appointment.patient_gender || 'N/A' %></div>
                        <div class="col-6"><strong>DOB:</strong> <%= appointment.date_of_birth || 'N/A' %></div>
                        <div class="col-6"><strong>Blood:</strong> <span class="badge bg-danger-subtle text-danger"><%= appointment.blood_group || 'N/A' %></span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Doctor & Department Card -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-person-badge-fill text-primary me-2"></i>Specialist Doctor
                    </h6>
                    <a href="/doctors/view/<%= appointment.doctor_pk %>" class="btn btn-sm btn-link text-primary fw-semibold p-0">View Profile</a>
                </div>
                <div class="card-body p-3">
                    <h5 class="fw-bold text-dark mb-1"><%= appointment.doctor_name %></h5>
                    <p class="text-muted fw-medium mb-3">
                        <span class="text-primary"><%= appointment.specialization %></span> &bull; <%= appointment.department_name %>
                    </p>
                    <hr class="my-2 opacity-25">
                    <div class="row g-2 small text-muted">
                        <div class="col-6"><strong>Room:</strong> <%= appointment.room_number || 'Room N/A' %></div>
                        <div class="col-6"><strong>Fee:</strong> <span class="text-success fw-bold">Rs. <%= Number(appointment.consultation_fee).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Appointment Meta Card -->
        <div class="col-12 col-md-12 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-white border-bottom p-3">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-info-circle-fill text-primary me-2"></i>Booking Metadata
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="mb-2 small">
                        <strong class="text-dark">Reason / Complaint:</strong>
                        <div class="p-2 bg-light rounded text-muted mt-1"><%= appointment.reason || 'General Consultation' %></div>
                    </div>
                    <% if (appointment.notes) { %>
                        <div class="mb-2 small">
                            <strong class="text-dark">Notes:</strong>
                            <div class="p-2 bg-light rounded text-muted mt-1"><%= appointment.notes %></div>
                        </div>
                    <% } %>
                    <div class="small text-muted mt-3 pt-2 border-top">
                        Created by <strong><%= appointment.created_by_name || 'System' %></strong> on <%= appointment.created_at %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Medical History Context -->
    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="card-header bg-white border-bottom p-3">
            <h6 class="fw-bold mb-0 text-dark">
                <i class="bi bi-file-earmark-medical-fill text-primary me-2"></i>Patient's Medical Records & Previous Visits
            </h6>
        </div>
        <div class="card-body p-4">
            <% if (medicalRecords && medicalRecords.length > 0) { %>
                <div class="row g-3">
                    <% medicalRecords.forEach(rec => { %>
                        <div class="col-12 col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-primary"><i class="bi bi-calendar-event me-1"></i><%= rec.visit_date %></strong>
                                    <span class="badge bg-secondary-subtle text-secondary">Visit Record</span>
                                </div>
                                <h6 class="fw-bold text-dark mb-1"><%= rec.diagnosis %></h6>
                                <p class="text-muted small mb-2"><%= rec.symptoms %></p>
                                <% if (rec.prescription) { %>
                                    <div class="small text-dark font-monospace bg-white p-2 rounded border mb-0">
                                        <i class="bi bi-capsule text-success me-1"></i><%= rec.prescription.split('\n')[0] %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="text-center py-3 text-muted">
                    <p class="mb-0">No prior medical records logged for this patient yet.</p>
                </div>
            <% } %>
        </div>
    </div>

</div>
