<!-- Appointment Management View (List & Calendar / Schedule View) -->
<div class="container-fluid px-0">

    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Page Header & Action -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-calendar-check-fill text-primary me-2"></i>Appointment Management & Scheduling
            </h3>
            <p class="text-muted mb-0">Book, reschedule, track statuses, and view doctor clinical schedules</p>
        </div>
        <div>
            <a href="/appointments/book" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium">
                <i class="bi bi-calendar-plus-fill fs-5"></i>
                <span>Book Appointment</span>
            </a>
        </div>
    </div>

    <!-- Metric KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-calendar-event fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Total Bookings</div>
                        <h4 class="fw-bold mb-0 text-dark"><%= stats.total %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Today's Appointments</div>
                        <h4 class="fw-bold mb-0 text-info"><%= stats.today %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Completed</div>
                        <h4 class="fw-bold mb-0 text-success"><%= stats.completed %></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-x-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Cancelled / No-Show</div>
                        <h4 class="fw-bold mb-0 text-danger"><%= stats.cancelled %></h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters & Search Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <form action="/appointments" method="GET" class="row g-2 align-items-center">
                <input type="hidden" name="view" value="<%= viewMode %>">
                <div class="col-12 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-start-0 ps-0" placeholder="Appt #, Patient, Doctor..." value="<%= search %>">
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <select name="doctor_id" class="form-select bg-light">
                        <option value="">All Doctors</option>
                        <% doctors.forEach(doc => { %>
                            <option value="<%= doc.id %>" <%= doctorId == doc.id ? 'selected' : '' %>>
                                <%= doc.full_name %> (<%= doc.specialization %>)
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <select name="status" class="form-select bg-light">
                        <option value="">All Statuses</option>
                        <option value="Scheduled" <%= status === 'Scheduled' ? 'selected' : '' %>>Scheduled</option>
                        <option value="Completed" <%= status === 'Completed' ? 'selected' : '' %>>Completed</option>
                        <option value="Cancelled" <%= status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                        <option value="No-Show" <%= status === 'No-Show' ? 'selected' : '' %>>No-Show</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <input type="date" name="date" class="form-control bg-light" value="<%= selectedDate %>">
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-medium">Filter</button>
                    <a href="/appointments" class="btn btn-outline-secondary px-3" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- View Mode Switcher Header -->
    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0 text-dark">
                <% if (viewMode === 'schedule') { %>
                    <i class="bi bi-calendar-week text-primary me-2"></i>Doctor Calendar & Time Schedule
                <% } else { %>
                    <i class="bi bi-list-ul text-primary me-2"></i>Appointments Directory
                <% } %>
            </h5>
            <div class="btn-group shadow-sm" role="group" aria-label="View mode toggle">
                <a href="/appointments?view=list<%= search ? '&search=' + search : '' %><%= status ? '&status=' + status : '' %><%= doctorId ? '&doctor_id=' + doctorId : '' %><%= selectedDate ? '&date=' + selectedDate : '' %>" 
                   class="btn btn-sm <%= viewMode !== 'schedule' ? 'btn-primary fw-bold' : 'btn-light border text-muted' %> px-3">
                    <i class="bi bi-table me-1"></i> List View
                </a>
                <a href="/appointments?view=schedule<%= search ? '&search=' + search : '' %><%= status ? '&status=' + status : '' %><%= doctorId ? '&doctor_id=' + doctorId : '' %><%= selectedDate ? '&date=' + selectedDate : '' %>" 
                   class="btn btn-sm <%= viewMode === 'schedule' ? 'btn-primary fw-bold' : 'btn-light border text-muted' %> px-3">
                    <i class="bi bi-calendar3 me-1"></i> Schedule Calendar
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            <% if (viewMode !== 'schedule') { %>
                <!-- ================= LIST VIEW TABLE ================= -->
                <% if (appointments && appointments.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Appt #</th>
                                    <th>Patient</th>
                                    <th>Doctor & Department</th>
                                    <th>Date & Time</th>
                                    <th>Reason for Visit</th>
                                    <th>Status</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% appointments.forEach(apt => { %>
                                    <tr>
                                        <td class="ps-3">
                                            <a href="/appointments/view/<%= apt.id %>" class="fw-bold text-primary text-decoration-none">
                                                <%= apt.appointment_number %>
                                            </a>
                                        </td>
                                        <td>
                                            <a href="/patients/view/<%= apt.patient_uid %>" class="text-dark fw-bold text-decoration-none">
                                                <%= apt.patient_first_name %> <%= apt.patient_last_name %>
                                            </a>
                                            <div class="small text-muted"><i class="bi bi-card-text me-1"></i><%= apt.patient_uid %></div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark"><%= apt.doctor_name %></div>
                                            <div class="small text-muted"><%= apt.specialization %> &bull; <span class="text-secondary"><%= apt.department_name %></span></div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark"><i class="bi bi-calendar3 me-1 text-primary"></i><%= apt.appointment_date %></div>
                                            <div class="small text-muted"><i class="bi bi-clock me-1 text-primary"></i><%= apt.appointment_time %></div>
                                        </td>
                                        <td>
                                            <span class="text-dark"><%= apt.reason || 'General Consultation' %></span>
                                        </td>
                                        <td>
                                            <% if (apt.status === 'Scheduled') { %>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-semibold">Scheduled</span>
                                            <% } else if (apt.status === 'Completed') { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-semibold">Completed</span>
                                            <% } else if (apt.status === 'Cancelled') { %>
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-semibold">Cancelled</span>
                                            <% } else { %>
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 fw-semibold"><%= apt.status %></span>
                                            <% } %>
                                        </td>
                                        <td class="text-end pe-3">
                                            <div class="dropdown d-inline-block">
                                                <button class="btn btn-sm btn-light border text-muted px-2" type="button" data-bs-toggle="dropdown">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                    <li>
                                                        <a class="dropdown-item" href="/appointments/view/<%= apt.id %>">
                                                            <i class="bi bi-eye text-primary me-2"></i> View Details
                                                        </a>
                                                    </li>
                                                    <% if (apt.status === 'Scheduled') { %>
                                                        <li>
                                                            <form action="/appointments/status/<%= apt.id %>" method="POST" class="d-inline">
                                                                <input type="hidden" name="status" value="Completed">
                                                                <button type="submit" class="dropdown-item text-success">
                                                                    <i class="bi bi-check-circle me-2"></i> Mark Completed
                                                                </button>
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item text-warning-emphasis" href="/appointments/reschedule/<%= apt.id %>">
                                                                <i class="bi bi-clock-history me-2"></i> Reschedule
                                                            </a>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <form action="/appointments/status/<%= apt.id %>" method="POST" class="d-inline">
                                                                <input type="hidden" name="status" value="Cancelled">
                                                                <button type="submit" class="dropdown-item text-danger" onclick="return confirm('Cancel this appointment?')">
                                                                    <i class="bi bi-x-circle me-2"></i> Cancel Appointment
                                                                </button>
                                                            </form>
                                                        </li>
                                                    <% } %>
                                                </ul>
                                            </div>
                                            <a href="/appointments/view/<%= apt.id %>" class="btn btn-sm btn-outline-primary fw-medium ms-1">View</a>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x display-4 mb-3 text-secondary d-block"></i>
                        <h5 class="fw-bold text-dark mb-1">No Appointments Found</h5>
                        <p class="text-muted mb-3">No scheduling records match the selected filter criteria.</p>
                        <a href="/appointments/book" class="btn btn-primary fw-medium px-4">Book New Appointment</a>
                    </div>
                <% } %>

            <% } else { %>
                <!-- ================= CALENDAR / SCHEDULE MATRIX VIEW ================= -->
                <div class="p-4 bg-light">
                    <div class="d-flex align-items-center justify-content-between mb-3 bg-white p-3 rounded-3 shadow-sm">
                        <div>
                            <h6 class="fw-bold text-dark mb-0">Daily Clinical Timetable Grid</h6>
                            <small class="text-muted">Filtered Date: <strong><%= selectedDate || todayStr %></strong></small>
                        </div>
                        <div class="d-flex gap-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1"><i class="bi bi-circle-fill me-1 small"></i> Scheduled</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1"><i class="bi bi-circle-fill me-1 small"></i> Completed</span>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1"><i class="bi bi-circle-fill me-1 small"></i> Cancelled</span>
                        </div>
                    </div>

                    <% 
                        // Time slot matrix array
                        const timeSlots = ['08:30 AM', '09:00 AM', '09:30 AM', '10:00 AM', '10:30 AM', '11:00 AM', '11:30 AM', '02:00 PM', '02:30 PM', '03:00 PM', '03:30 PM', '04:00 PM'];
                    %>

                    <div class="table-responsive bg-white rounded-3 shadow-sm">
                        <table class="table table-bordered mb-0 align-middle">
                            <thead class="table-light text-center">
                                <tr>
                                    <th style="width: 120px;">Time Slot</th>
                                    <% doctors.forEach(doc => { %>
                                        <th>
                                            <div class="fw-bold text-dark"><%= doc.full_name %></div>
                                            <div class="small text-muted"><%= doc.specialization %> &bull; <%= doc.department_name %></div>
                                        </th>
                                    <% }); %>
                                </tr>
                            </thead>
                            <tbody>
                                <% timeSlots.forEach(slot => { %>
                                    <tr>
                                        <td class="text-center fw-bold text-muted bg-light small py-3">
                                            <i class="bi bi-clock me-1 text-primary"></i> <%= slot %>
                                        </td>
                                        <% doctors.forEach(doc => { 
                                            // Find if appointment exists for this doctor & time slot
                                            const matchedApt = appointments.find(a => a.doctor_id == doc.id && a.appointment_time === slot);
                                        %>
                                            <td class="p-2 text-center" style="height: 70px;">
                                                <% if (matchedApt) { %>
                                                    <div class="card border-0 rounded-2 p-2 text-start shadow-sm <%= matchedApt.status === 'Completed' ? 'bg-success bg-opacity-10 border-start border-4 border-success' : (matchedApt.status === 'Cancelled' ? 'bg-danger bg-opacity-10 border-start border-4 border-danger' : 'bg-primary bg-opacity-10 border-start border-4 border-primary') %>">
                                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                                            <a href="/appointments/view/<%= matchedApt.id %>" class="fw-bold text-dark text-decoration-none small text-truncate">
                                                                <%= matchedApt.patient_first_name %> <%= matchedApt.patient_last_name %>
                                                            </a>
                                                            <a href="/appointments/view/<%= matchedApt.id %>" class="btn btn-sm p-0 text-muted" title="View details"><i class="bi bi-arrow-right-short fs-6"></i></a>
                                                        </div>
                                                        <div class="small text-muted text-truncate" style="font-size: 11px;">
                                                            <i class="bi bi-ticket-perforated me-1"></i><%= matchedApt.appointment_number %>
                                                        </div>
                                                    </div>
                                                <% } else { %>
                                                    <a href="/appointments/book?doctor_id=<%= doc.id %>&time=<%= slot %>&date=<%= selectedDate || todayStr %>" class="btn btn-sm btn-light w-100 text-muted border border-dashed py-2 opacity-75 hover-opacity-100" style="border-style: dashed !important;">
                                                        <i class="bi bi-plus-circle me-1"></i> Book
                                                    </a>
                                                <% } %>
                                            </td>
                                        <% }); %>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

</div>
